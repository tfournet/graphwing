{
  "slug": "graphwing-pr-status",
  "name": "graphwing-pr-status",
  "description": "Read-only PR status. Native nodes classify normalized raw PR identity, labels, review, mergeability, merge-state, exact stable head, and normalized checks into closed readiness reasons. No test, git write, or merge effect. Start through API input.pr; webhook remains disabled.",
  "spec": {
    "meta": {
      "useSearchAttributes": true
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.manual",
        "label": "Start",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {}
      },
      {
        "id": "hook",
        "type": "trigger.webhook",
        "label": "Webhook",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "enabled": false,
          "requireAuthHeader": false,
          "allowedMethods": [
            "POST"
          ]
        }
      },
      {
        "id": "join_start",
        "type": "logic.join.any",
        "label": "Start from any trigger",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "stopOnFirst": true
        }
      },
      {
        "id": "view",
        "type": "action.graphwing.GET:/v1/gh/pr/view",
        "label": "Fresh PR state",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "$GRAPHWING_STATUS_REPO",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "checks",
        "type": "action.graphwing.GET:/v1/gh/pr/checks",
        "label": "Declared GitHub checks",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "$GRAPHWING_STATUS_REPO",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "herdr_view_http",
        "type": "action.noop",
        "label": "Herdr: Malformed/unknown PR response",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {}
      },
      {
        "id": "herdr_checks_http",
        "type": "action.noop",
        "label": "Herdr: Malformed/unknown checks transport",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {}
      },
      {
        "id": "confirm_view",
        "type": "action.graphwing.GET:/v1/gh/pr/view",
        "label": "Confirm exact PR head",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "$GRAPHWING_STATUS_REPO",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "status_label_names",
        "type": "transforms.objectBuilder",
        "label": "Normalize label names",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "alias": "status_label_names",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "names",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.label_names"
              }
            }
          ]
        }
      },
      {
        "id": "status_hold_labels",
        "type": "transforms.transformArray",
        "label": "Select hold labels",
        "position": {
          "x": 80,
          "y": 0
        },
        "config": {
          "alias": "status_hold_labels",
          "operation": "filter",
          "array": {
            "inputKind": "ast",
            "ast": {
              "kind": "getField",
              "path": "CTX.status_label_names.names"
            }
          },
          "filterCondition": {
            "inputKind": "ast",
            "ast": {
              "kind": "binary",
              "operator": "==",
              "left": {
                "kind": "function",
                "name": "substring",
                "args": [
                  {
                    "kind": "getField",
                    "path": "ITEM"
                  },
                  {
                    "kind": "literal",
                    "value": 0
                  },
                  {
                    "kind": "literal",
                    "value": 5
                  }
                ]
              },
              "right": {
                "kind": "literal",
                "value": "hold:"
              }
            }
          }
        }
      },
      {
        "id": "status_policy_snap",
        "type": "transforms.objectBuilder",
        "label": "Native final policy facts",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "alias": "status_policy_snap",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "first_head",
              "expression": {
                "kind": "getField",
                "path": "TASKS.view.data.data.headRefOid"
              }
            },
            {
              "id": "m2",
              "output": "headRefOid",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.headRefOid"
              }
            },
            {
              "id": "m3",
              "output": "state",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.state"
              }
            },
            {
              "id": "m4",
              "output": "isDraft",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.isDraft"
              }
            },
            {
              "id": "m5",
              "output": "labels",
              "expression": {
                "kind": "getField",
                "path": "CTX.status_label_names.names"
              }
            },
            {
              "id": "m6",
              "output": "hold_count",
              "expression": {
                "kind": "function",
                "name": "count",
                "args": [
                  {
                    "kind": "getField",
                    "path": "CTX.status_hold_labels"
                  }
                ]
              }
            },
            {
              "id": "m7",
              "output": "reviewDecision",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.reviewDecision"
              }
            },
            {
              "id": "m8",
              "output": "mergeable",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.mergeable"
              }
            },
            {
              "id": "m9",
              "output": "mergeStateStatus",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.data.mergeStateStatus"
              }
            },
            {
              "id": "m10",
              "output": "checks_state",
              "expression": {
                "kind": "getField",
                "path": "TASKS.checks.data.checks_state"
              }
            },
            {
              "id": "m11",
              "output": "closed",
              "expression": {
                "kind": "binary",
                "operator": "in",
                "left": {
                  "kind": "getField",
                  "path": "TASKS.confirm_view.data.data.state"
                },
                "right": {
                  "kind": "array",
                  "elements": [
                    {
                      "kind": "literal",
                      "value": "CLOSED"
                    },
                    {
                      "kind": "literal",
                      "value": "MERGED"
                    }
                  ]
                }
              }
            },
            {
              "id": "m12",
              "output": "held",
              "expression": {
                "kind": "binary",
                "operator": "or",
                "left": {
                  "kind": "binary",
                  "operator": "==",
                  "left": {
                    "kind": "getField",
                    "path": "TASKS.confirm_view.data.data.isDraft"
                  },
                  "right": {
                    "kind": "literal",
                    "value": true
                  }
                },
                "right": {
                  "kind": "binary",
                  "operator": ">",
                  "left": {
                    "kind": "function",
                    "name": "count",
                    "args": [
                      {
                        "kind": "getField",
                        "path": "CTX.status_hold_labels"
                      }
                    ]
                  },
                  "right": {
                    "kind": "literal",
                    "value": 0
                  }
                }
              }
            },
            {
              "id": "m13",
              "output": "review_red",
              "expression": {
                "kind": "binary",
                "operator": "in",
                "left": {
                  "kind": "getField",
                  "path": "TASKS.confirm_view.data.data.reviewDecision"
                },
                "right": {
                  "kind": "array",
                  "elements": [
                    {
                      "kind": "literal",
                      "value": "CHANGES_REQUESTED"
                    },
                    {
                      "kind": "literal",
                      "value": "REVIEW_REQUIRED"
                    }
                  ]
                }
              }
            },
            {
              "id": "m14",
              "output": "review_ok",
              "expression": {
                "kind": "binary",
                "operator": "in",
                "left": {
                  "kind": "getField",
                  "path": "TASKS.confirm_view.data.data.reviewDecision"
                },
                "right": {
                  "kind": "array",
                  "elements": [
                    {
                      "kind": "literal",
                      "value": null
                    },
                    {
                      "kind": "literal",
                      "value": ""
                    },
                    {
                      "kind": "literal",
                      "value": "APPROVED"
                    }
                  ]
                }
              }
            },
            {
              "id": "m15",
              "output": "head_consistent",
              "expression": {
                "kind": "binary",
                "operator": "==",
                "left": {
                  "kind": "getField",
                  "path": "TASKS.view.data.data.headRefOid"
                },
                "right": {
                  "kind": "getField",
                  "path": "TASKS.confirm_view.data.data.headRefOid"
                }
              }
            },
            {
              "id": "m16",
              "output": "unknown_merge",
              "expression": {
                "kind": "binary",
                "operator": "or",
                "left": {
                  "kind": "binary",
                  "operator": "==",
                  "left": {
                    "kind": "getField",
                    "path": "TASKS.confirm_view.data.data.mergeable"
                  },
                  "right": {
                    "kind": "literal",
                    "value": "UNKNOWN"
                  }
                },
                "right": {
                  "kind": "binary",
                  "operator": "==",
                  "left": {
                    "kind": "getField",
                    "path": "TASKS.confirm_view.data.data.mergeStateStatus"
                  },
                  "right": {
                    "kind": "literal",
                    "value": "UNKNOWN"
                  }
                }
              }
            },
            {
              "id": "m17",
              "output": "conflicting_state",
              "expression": {
                "kind": "binary",
                "operator": "or",
                "left": {
                  "kind": "binary",
                  "operator": "or",
                  "left": {
                    "kind": "binary",
                    "operator": "==",
                    "left": {
                      "kind": "getField",
                      "path": "TASKS.confirm_view.data.data.mergeable"
                    },
                    "right": {
                      "kind": "literal",
                      "value": "CONFLICTING"
                    }
                  },
                  "right": {
                    "kind": "binary",
                    "operator": "in",
                    "left": {
                      "kind": "getField",
                      "path": "TASKS.confirm_view.data.data.mergeStateStatus"
                    },
                    "right": {
                      "kind": "array",
                      "elements": [
                        {
                          "kind": "literal",
                          "value": "BLOCKED"
                        },
                        {
                          "kind": "literal",
                          "value": "BEHIND"
                        },
                        {
                          "kind": "literal",
                          "value": "DIRTY"
                        },
                        {
                          "kind": "literal",
                          "value": "DRAFT"
                        },
                        {
                          "kind": "literal",
                          "value": "HAS_HOOKS"
                        },
                        {
                          "kind": "literal",
                          "value": "UNSTABLE"
                        }
                      ]
                    }
                  }
                },
                "right": {
                  "kind": "unary",
                  "operator": "not",
                  "operand": {
                    "kind": "binary",
                    "operator": "==",
                    "left": {
                      "kind": "getField",
                      "path": "TASKS.view.data.data.headRefOid"
                    },
                    "right": {
                      "kind": "getField",
                      "path": "TASKS.confirm_view.data.data.headRefOid"
                    }
                  }
                }
              }
            },
            {
              "id": "mrequested_number",
              "output": "requested_number",
              "expression": {
                "kind": "getField",
                "path": "TASKS.confirm_view.data.requested_number"
              }
            }
          ]
        }
      },
      {
        "id": "switch_status_policy",
        "type": "logic.switch",
        "label": "Native final readiness policy",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "malformed",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "malformed"
                }
              ]
            },
            {
              "label": "closed",
              "rules": [
                {
                  "path": "closed",
                  "op": "equals",
                  "value": true
                }
              ]
            },
            {
              "label": "held",
              "rules": [
                {
                  "path": "held",
                  "op": "equals",
                  "value": true
                }
              ]
            },
            {
              "label": "review-red",
              "rules": [
                {
                  "path": "review_red",
                  "op": "equals",
                  "value": true
                }
              ]
            },
            {
              "label": "CI-red",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "red"
                }
              ]
            },
            {
              "label": "pending",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "pending"
                }
              ]
            },
            {
              "label": "no-checks",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "no_checks"
                }
              ]
            },
            {
              "label": "unknown",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "unknown"
                }
              ]
            },
            {
              "label": "conflicting",
              "rules": [
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "inconsistent"
                }
              ]
            },
            {
              "label": "unknown",
              "rules": [
                {
                  "path": "unknown_merge",
                  "op": "equals",
                  "value": true
                }
              ]
            },
            {
              "label": "conflicting",
              "rules": [
                {
                  "path": "conflicting_state",
                  "op": "equals",
                  "value": true
                }
              ]
            },
            {
              "label": "ready",
              "rules": [
                {
                  "path": "state",
                  "op": "equals",
                  "value": "OPEN"
                },
                {
                  "path": "isDraft",
                  "op": "equals",
                  "value": false
                },
                {
                  "path": "hold_count",
                  "op": "equals",
                  "value": 0
                },
                {
                  "path": "review_ok",
                  "op": "equals",
                  "value": true
                },
                {
                  "path": "checks_state",
                  "op": "equals",
                  "value": "green"
                },
                {
                  "path": "mergeable",
                  "op": "equals",
                  "value": "MERGEABLE"
                },
                {
                  "path": "mergeStateStatus",
                  "op": "equals",
                  "value": "CLEAN"
                },
                {
                  "path": "head_consistent",
                  "op": "equals",
                  "value": true
                }
              ]
            }
          ],
          "default": {
            "label": "malformed"
          }
        }
      },
      {
        "id": "status_reason_held",
        "type": "transforms.objectBuilder",
        "label": "Final policy: held",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "alias": "status_reason_held",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "status",
              "expression": {
                "kind": "literal",
                "value": "blocked"
              }
            },
            {
              "id": "m2",
              "output": "reason",
              "expression": {
                "kind": "literal",
                "value": "held"
              }
            },
            {
              "id": "m3",
              "output": "exact_head",
              "expression": {
                "kind": "getField",
