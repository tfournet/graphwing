# Copy to $GRAPHWING_HOME/tunnel.env for named-tunnel setup (setup_tunnel.py).
# Demo/quick tunnel needs none of this.
GRAPHWING_CF_EMAIL=you@example.com
GRAPHWING_CF_API_KEY=
# Optional Bitwarden Secrets lookup instead of GRAPHWING_CF_API_KEY:
# GRAPHWING_CF_BWS_KEY=your_bws_secret_key_name
GRAPHWING_CF_ZONE=example.com
GRAPHWING_HOSTNAME=graphwing.example.com
GRAPHWING_TUNNEL_NAME=graphwing
