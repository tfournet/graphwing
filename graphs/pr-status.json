{
  "slug": "graphwing-pr-status",
  "name": "graphwing-pr-status",
  "description": "Status doorbell. Unauthenticated webhook body {pr}. Snapshot checks+reviews. No writes. Payload: pr.",
  "spec": {
    "meta": { "useSearchAttributes": true },
    "nodes": [
      { "id": "trigger", "type": "trigger.manual", "label": "Start", "position": { "x": 0, "y": 200 }, "config": {} },
      {
        "id": "hook",
        "type": "trigger.webhook",
        "label": "Webhook",
        "position": { "x": 0, "y": 320 },
        "config": {
          "enabled": true,
          "requireAuthHeader": false,
          "allowedMethods": ["POST"]
        }
      },
      {
        "id": "join_start",
        "type": "logic.join.any",
        "label": "Start from any trigger",
        "position": { "x": 180, "y": 260 },
        "config": { "stopOnFirst": true }
      },
      {
        "id": "view",
        "type": "action.graphwing.GET:/v1/gh/pr/view",
        "label": "ghPrView",
        "position": { "x": 400, "y": 200 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "$GRAPHWING_STATUS_REPO",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "checks",
        "type": "action.graphwing.GET:/v1/gh/pr/checks",
        "label": "ghPrChecks",
        "position": { "x": 620, "y": 200 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "$GRAPHWING_STATUS_REPO",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "switch_checks",
        "type": "logic.switch",
        "label": "checks green/red/pending",
        "position": { "x": 840, "y": 200 },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "green",
              "rules": [{ "path": "data.all_green", "op": "equals", "value": true }]
            },
            {
              "label": "red",
              "rules": [{ "path": "data.any_red", "op": "equals", "value": true }]
            }
          ],
          "default": { "label": "pending" }
        }
      },
      {
        "id": "review_snap",
        "type": "transforms.objectBuilder",
        "label": "Review snapshot",
        "position": { "x": 1060, "y": 80 },
        "config": {
          "alias": "review_snap",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "review_decision", "expression": { "kind": "getField", "path": "TASKS.view.data.review_decision" } },
            { "id": "m2", "output": "reviews_blocking", "expression": { "kind": "getField", "path": "TASKS.view.data.reviews_blocking" } }
          ]
        }
      },
      {
        "id": "switch_review",
        "type": "logic.switch",
        "label": "reviews blocking?",
        "position": { "x": 1280, "y": 80 },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "changes",
              "rules": [{ "path": "review_decision", "op": "equals", "value": "CHANGES_REQUESTED" }]
            },
            {
              "label": "need_review",
              "rules": [{ "path": "review_decision", "op": "equals", "value": "REVIEW_REQUIRED" }]
            }
          ],
          "default": { "label": "mergeable" }
        }
      },
      {
        "id": "done_mergeable",
        "type": "transforms.objectBuilder",
        "label": "Done (mergeable)",
        "position": { "x": 1500, "y": 80 },
        "config": {
          "alias": "done_mergeable",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "literal", "value": "ok" } },
            { "id": "m2", "output": "reason", "expression": { "kind": "literal", "value": "mergeable" } },
            { "id": "m3", "output": "pr", "expression": { "kind": "getField", "path": "CTX.INPUT.pr" } }
          ]
        }
      },
      { "id": "herdr_no_pr", "type": "action.noop", "label": "Herdr: missing PR", "position": { "x": 620, "y": 440 }, "config": {} },
      { "id": "herdr_checks_http", "type": "action.noop", "label": "Herdr: checks HTTP failed", "position": { "x": 840, "y": 440 }, "config": {} },
      { "id": "herdr_pending", "type": "action.noop", "label": "Herdr: checks pending", "position": { "x": 1060, "y": 440 }, "config": {} },
      { "id": "herdr_red", "type": "action.noop", "label": "Herdr: checks red", "position": { "x": 1060, "y": 320 }, "config": {} },
      { "id": "herdr_changes_requested", "type": "action.noop", "label": "Herdr: changes requested", "position": { "x": 1500, "y": 240 }, "config": {} },
      { "id": "herdr_review_required", "type": "action.noop", "label": "Herdr: review required", "position": { "x": 1500, "y": 360 }, "config": {} }
    ],
    "edges": [
      { "id": "e_start_trigger", "source": "trigger", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_hook", "source": "hook", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_view", "source": "join_start", "sourceHandle": "out", "target": "view", "targetHandle": "in" },
      { "id": "e_view_success", "source": "view", "sourceHandle": "success", "target": "checks", "targetHandle": "in" },
      { "id": "e_view_failure", "source": "view", "sourceHandle": "failure", "target": "herdr_no_pr", "targetHandle": "in" },
      { "id": "e_checks_success", "source": "checks", "sourceHandle": "success", "target": "switch_checks", "targetHandle": "in" },
      { "id": "e_checks_failure", "source": "checks", "sourceHandle": "failure", "target": "herdr_checks_http", "targetHandle": "in" },
      { "id": "e_checks_green", "source": "switch_checks", "sourceHandle": "case-0", "target": "review_snap", "targetHandle": "in" },
      { "id": "e_review_snap", "source": "review_snap", "sourceHandle": "out", "target": "switch_review", "targetHandle": "in" },
      { "id": "e_review_changes", "source": "switch_review", "sourceHandle": "case-0", "target": "herdr_changes_requested", "targetHandle": "in" },
      { "id": "e_review_required", "source": "switch_review", "sourceHandle": "case-1", "target": "herdr_review_required", "targetHandle": "in" },
      { "id": "e_review_mergeable", "source": "switch_review", "sourceHandle": "default", "target": "done_mergeable", "targetHandle": "in" },
      { "id": "e_checks_red", "source": "switch_checks", "sourceHandle": "case-1", "target": "herdr_red", "targetHandle": "in" },
      { "id": "e_checks_pending", "source": "switch_checks", "sourceHandle": "default", "target": "herdr_pending", "targetHandle": "in" }
    ]
  }
}
