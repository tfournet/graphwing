#!/usr/bin/env bash
set -euo pipefail
export HERMES_HOME="${HERMES_HOME:-${GRAPHWING_HOME:-$HOME/.graphwing}}"
if [[ -n "${GRAPHWING_HERMES_BIN:-}" ]]; then
  exec "$GRAPHWING_HERMES_BIN" "$@"
fi
if command -v hermes >/dev/null 2>&1; then
  exec hermes "$@"
fi
if [[ -x "${HOME}/.local/bin/hermes" ]]; then
  exec "${HOME}/.local/bin/hermes" "$@"
fi
echo "graphwing: hermes not found (set GRAPHWING_HERMES_BIN or put hermes on PATH)" >&2
exit 127
