{
  "slug": "graphwing-visual-iteration",
  "name": "graphwing-visual-iteration",
  "description": "One bounded visual-design turn. It records exact feedback or a distinct planning decision, resumes the saved writer, runs changed-area tests and typecheck, composes the real-browser graphwing-visual-evidence workflow for scenario, UI review, verified screenshots, and the numbered GitHub issue comment, then reports the candidate to the exact saved planning pane. Turn 20 pauses once; turn 21 and later have no hard ceiling. A final-gate visible fix returns through the same path. This graph never commits, pushes, or opens a PR.",
  "canary": {
    "fixture": "deterministic-visual-iteration-v1",
    "issue": "https://github.com/tfournet/graphwing/issues/52",
    "turn": 21,
    "round": 21,
    "decision": "design_ready",
    "expected_steps": ["feedback", "write", "changed-area", "typecheck", "real-scenario", "ui-review", "verified-screenshots", "github-comment", "planning-pane"]
  },
  "spec": {
    "meta": { "useSearchAttributes": true },
    "nodes": [
      { "id": "trigger", "type": "trigger.manual", "label": "Start one visual iteration turn", "position": { "x": 0, "y": 80 }, "config": {} },
      { "id": "form", "type": "trigger.form", "label": "Visual iteration form", "position": { "x": 0, "y": 200 }, "config": { "enabled": true, "allowDrafts": false, "inputs": { "build_id": { "type": "string", "required": true }, "event_id": { "type": "string", "required": true }, "action": { "type": "string", "required": true, "enum": ["feedback", "decision", "return", "resume"] }, "notes": { "type": "string", "required": false }, "round": { "type": "number", "required": false }, "decision": { "type": "string", "required": false, "enum": ["continue", "design_ready", "reframe", "split", "park", "stop"] }, "note": { "type": "string", "required": false }, "finding": { "type": "string", "required": false }, "gate": { "type": "string", "required": false } } } },
      { "id": "hook", "type": "trigger.webhook", "label": "Visual iteration webhook", "position": { "x": 0, "y": 320 }, "config": { "enabled": true, "requireAuthHeader": true, "headerKey": "x-rewst-secret", "headerValue": "$GRAPHWING_HOOK_SECRET", "allowedMethods": ["POST"] } },
      { "id": "join_start", "type": "logic.join.any", "label": "Start from one trigger", "position": { "x": 160, "y": 200 }, "config": { "stopOnFirst": true } },
      { "id": "input_switch", "type": "logic.switch", "label": "Use the requested bounded action", "position": { "x": 320, "y": 200 }, "config": { "value": "{{ CTX.INPUT.action }}", "cases": [{ "id": "case-feedback", "equals": "feedback" }, { "id": "case-decision", "equals": "decision" }, { "id": "case-return", "equals": "return" }, { "id": "case-resume", "equals": "resume" }] } },

      { "id": "feedback_round_required", "type": "logic.filter", "label": "Feedback requires the published evidence round identity", "position": { "x": 400, "y": 40 }, "config": { "group": "AND", "rules": [{ "path": "CTX.INPUT.round", "op": "greater_than", "value": 0 }] } },
      { "id": "feedback", "type": "action.graphwing.POST:/v1/build/iteration/feedback", "label": "Record exact feedback against exact round", "position": { "x": 480, "y": 40 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.feedback", "holder": "event:{{ CTX.INPUT.event_id }}", "notes": "{{ CTX.INPUT.notes }}", "round": "{{ CTX.INPUT.round }}" } },
      { "id": "feedback_step", "type": "logic.switch", "label": "Honor feedback result", "position": { "x": 640, "y": 40 }, "config": { "value": "{{ TASKS.feedback.data.step }}", "cases": [{ "id": "case-write", "equals": "write" }, { "id": "case-checkpoint", "equals": "checkpoint" }] } },
      { "id": "join_checkpoint", "type": "logic.join.any", "label": "Join advisory checkpoint", "position": { "x": 720, "y": 0 }, "config": { "stopOnFirst": true } },
      { "id": "checkpoint", "type": "action.noop", "label": "Turn 20 checkpoint: continue, reframe, split, or park", "position": { "x": 800, "y": 0 }, "config": { "turn": 20, "later_ceiling": null } },

      { "id": "decision", "type": "action.graphwing.POST:/v1/build/iteration/decision", "label": "Record distinct planning decision", "position": { "x": 480, "y": 120 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.decision", "holder": "event:{{ CTX.INPUT.event_id }}", "decision": "{{ CTX.INPUT.decision }}", "note": "{{ CTX.INPUT.note }}" } },
      { "id": "decision_done", "type": "action.noop", "label": "Decision receipt: design_ready, reframe, split, park, or stop", "position": { "x": 640, "y": 120 }, "config": { "final_gate_visible_fix": "returns through action=return" } },

      { "id": "return", "type": "action.graphwing.POST:/v1/build/iteration/return", "label": "Return visible final-gate fix", "position": { "x": 480, "y": 200 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.return", "holder": "event:{{ CTX.INPUT.event_id }}", "finding": "{{ CTX.INPUT.finding }}", "gate": "{{ CTX.INPUT.gate }}" } },

      { "id": "next", "type": "action.graphwing.GET:/v1/build/iteration/next", "label": "Read one durable next step", "position": { "x": 480, "y": 300 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}" } },
      { "id": "step_switch", "type": "logic.switch", "label": "Resume the saved turn", "position": { "x": 640, "y": 300 }, "config": { "value": "{{ TASKS.next.data.step }}", "cases": [{ "id": "case-write", "equals": "write" }, { "id": "case-checks", "equals": "checks" }, { "id": "case-round", "equals": "round" }, { "id": "case-report", "equals": "report" }, { "id": "case-feedback", "equals": "feedback" }, { "id": "case-checkpoint", "equals": "checkpoint" }, { "id": "case-decision", "equals": "decision" }, { "id": "case-final-gates", "equals": "final_gates" }, { "id": "case-done", "equals": "done" }, { "id": "case-parked", "equals": "parked" }] } },
      { "id": "await_feedback", "type": "action.noop", "label": "Await exact human feedback", "position": { "x": 800, "y": 260 }, "config": {} },
      { "id": "await_decision", "type": "action.noop", "label": "Await planning decision", "position": { "x": 800, "y": 300 }, "config": { "allowed": ["design_ready", "reframe", "split", "park", "stop"] } },
      { "id": "final_gates", "type": "action.noop", "label": "Design ready: hand back to final gates", "position": { "x": 800, "y": 340 }, "config": { "visible_fix_action": "return" } },
      { "id": "already_done", "type": "action.noop", "label": "Visual iteration already complete", "position": { "x": 800, "y": 380 }, "config": {} },

      { "id": "join_write", "type": "logic.join.any", "label": "Join due writer lane", "position": { "x": 960, "y": 120 }, "config": { "stopOnFirst": true } },
      { "id": "claim", "type": "action.graphwing.POST:/v1/build/claim", "label": "Reserve same design writer", "position": { "x": 1120, "y": 120 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.claim", "holder": "event:{{ CTX.INPUT.event_id }}", "kind": "design" } },
      { "id": "wait_writer", "type": "action.wait.webhook", "label": "Wait for bounded resumed writer", "position": { "x": 1280, "y": 60 }, "config": { "alias": "wait_writer", "allowedMethods": ["POST"], "authMode": "token", "responseStatus": 200, "timeoutSeconds": 900 } },
      { "id": "launch_writer", "type": "action.graphwing.POST:/v1/build/writer/launch", "label": "Resume saved writer session", "position": { "x": 1280, "y": 180 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "claim_id": "{{ TASKS.claim.data.receipt.event_id }}", "holder": "event:{{ CTX.INPUT.event_id }}", "response_webhook_url": "{{ TASKS.wait_writer.pending.resumeUrl }}", "response_webhook_token": "{{ TASKS.wait_writer.pending.resumeToken }}" } },
      { "id": "writer_ok", "type": "logic.filter", "label": "Writer returned a candidate", "position": { "x": 1440, "y": 60 }, "config": { "group": "AND", "rules": [{ "path": "request.body.status", "op": "equals", "value": "ok" }] } },
      { "id": "writer_complete", "type": "action.graphwing.POST:/v1/build/writer/complete", "label": "Record writer result", "position": { "x": 1600, "y": 60 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.complete", "holder": "event:{{ CTX.INPUT.event_id }}", "claim_id": "{{ TASKS.claim.data.receipt.event_id }}", "job_id": "{{ TASKS.launch_writer.data.job_id }}", "harness_session": "{{ TASKS.launch_writer.data.harness_session }}", "callback": "{{ TASKS.wait_writer.request.body }}" } },

      { "id": "join_checks", "type": "logic.join.any", "label": "Join changed-area gate", "position": { "x": 1760, "y": 120 }, "config": { "stopOnFirst": true } },
      { "id": "wait_checks", "type": "action.wait.webhook", "label": "Wait for changed-area tests and typecheck", "position": { "x": 1920, "y": 60 }, "config": { "alias": "wait_checks", "allowedMethods": ["POST"], "authMode": "token", "responseStatus": 200, "timeoutSeconds": 900 } },
      { "id": "checks", "type": "action.graphwing.POST:/v1/build/checks", "label": "Run changed-area tests and typecheck", "position": { "x": 1920, "y": 180 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "phase": "fast", "response_webhook_url": "{{ TASKS.wait_checks.pending.resumeUrl }}", "response_webhook_token": "{{ TASKS.wait_checks.pending.resumeToken }}" } },
      { "id": "checks_ok", "type": "logic.filter", "label": "All required checks passed", "position": { "x": 2080, "y": 60 }, "config": { "group": "AND", "rules": [{ "path": "request.body.ok", "op": "equals", "value": true }] } },

      { "id": "join_round", "type": "logic.join.any", "label": "Join real visual evidence lane", "position": { "x": 2240, "y": 120 }, "config": { "stopOnFirst": true } },
      { "id": "visual_evidence", "type": "action.workflow.run", "label": "Real scenario, UI review, verified screenshots, GitHub comment", "position": { "x": 2400, "y": 120 }, "config": { "workflowSlug": "graphwing-visual-evidence", "waitForCompletion": true, "timeoutSeconds": 1800, "input": { "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.evidence" }, "required_receipt": "published round with GitHub issue comment and durable screenshots" } },
      { "id": "visual_ok", "type": "logic.filter", "label": "Visual evidence workflow completed", "position": { "x": 2560, "y": 120 }, "config": { "group": "AND", "rules": [{ "path": "data.status", "op": "equals", "value": "completed" }] } },

      { "id": "join_report", "type": "logic.join.any", "label": "Join exact planning report lane", "position": { "x": 2720, "y": 120 }, "config": { "stopOnFirst": true } },
      { "id": "report", "type": "action.graphwing.POST:/v1/build/iteration/report", "label": "Report to exact saved planning pane", "position": { "x": 2880, "y": 120 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.report", "holder": "event:{{ CTX.INPUT.event_id }}" } },
      { "id": "done", "type": "action.noop", "label": "One candidate returned; preview and history preserved", "position": { "x": 3040, "y": 120 }, "config": { "pre_commit": true } },

      { "id": "join_fail", "type": "logic.join.any", "label": "Join fail-closed terminals", "position": { "x": 2560, "y": 440 }, "config": { "stopOnFirst": true } },
      { "id": "failed", "type": "action.noop", "label": "Turn incomplete; files, stack, and history preserved", "position": { "x": 2720, "y": 440 }, "config": {} }
    ],
    "edges": [
      { "id": "e_trigger", "source": "trigger", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_form", "source": "form", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_hook", "source": "hook", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start", "source": "join_start", "sourceHandle": "out", "target": "input_switch", "targetHandle": "in" },
      { "id": "e_input_feedback", "source": "input_switch", "sourceHandle": "case-feedback", "target": "feedback_round_required", "targetHandle": "in" },
      { "id": "e_feedback_round_present", "source": "feedback_round_required", "sourceHandle": "pass", "target": "feedback", "targetHandle": "in" },
      { "id": "e_feedback_round_missing", "source": "feedback_round_required", "sourceHandle": "fail", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_input_decision", "source": "input_switch", "sourceHandle": "case-decision", "target": "decision", "targetHandle": "in" },
      { "id": "e_input_return", "source": "input_switch", "sourceHandle": "case-return", "target": "return", "targetHandle": "in" },
      { "id": "e_input_resume", "source": "input_switch", "sourceHandle": "case-resume", "target": "next", "targetHandle": "in" },
      { "id": "e_input_default", "source": "input_switch", "sourceHandle": "default", "target": "join_fail", "targetHandle": "in" },

      { "id": "e_feedback_ok", "source": "feedback", "sourceHandle": "success", "target": "feedback_step", "targetHandle": "in" },
      { "id": "e_feedback_fail", "source": "feedback", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_feedback_write", "source": "feedback_step", "sourceHandle": "case-write", "target": "join_write", "targetHandle": "in" },
      { "id": "e_feedback_checkpoint", "source": "feedback_step", "sourceHandle": "case-checkpoint", "target": "join_checkpoint", "targetHandle": "in" },
      { "id": "e_feedback_unknown", "source": "feedback_step", "sourceHandle": "default", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_decision_ok", "source": "decision", "sourceHandle": "success", "target": "decision_done", "targetHandle": "in" },
      { "id": "e_decision_fail", "source": "decision", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_return_ok", "source": "return", "sourceHandle": "success", "target": "join_write", "targetHandle": "in" },
      { "id": "e_return_fail", "source": "return", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },

      { "id": "e_next_ok", "source": "next", "sourceHandle": "success", "target": "step_switch", "targetHandle": "in" },
      { "id": "e_next_fail", "source": "next", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_step_write", "source": "step_switch", "sourceHandle": "case-write", "target": "join_write", "targetHandle": "in" },
      { "id": "e_step_checks", "source": "step_switch", "sourceHandle": "case-checks", "target": "join_checks", "targetHandle": "in" },
      { "id": "e_step_round", "source": "step_switch", "sourceHandle": "case-round", "target": "join_round", "targetHandle": "in" },
      { "id": "e_step_report", "source": "step_switch", "sourceHandle": "case-report", "target": "join_report", "targetHandle": "in" },
      { "id": "e_step_feedback", "source": "step_switch", "sourceHandle": "case-feedback", "target": "await_feedback", "targetHandle": "in" },
      { "id": "e_step_checkpoint", "source": "step_switch", "sourceHandle": "case-checkpoint", "target": "join_checkpoint", "targetHandle": "in" },
      { "id": "e_step_decision", "source": "step_switch", "sourceHandle": "case-decision", "target": "await_decision", "targetHandle": "in" },
      { "id": "e_step_final", "source": "step_switch", "sourceHandle": "case-final-gates", "target": "final_gates", "targetHandle": "in" },
      { "id": "e_step_done", "source": "step_switch", "sourceHandle": "case-done", "target": "already_done", "targetHandle": "in" },
      { "id": "e_step_parked", "source": "step_switch", "sourceHandle": "case-parked", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_step_unknown", "source": "step_switch", "sourceHandle": "default", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_checkpoint_join", "source": "join_checkpoint", "sourceHandle": "out", "target": "checkpoint", "targetHandle": "in" },

      { "id": "e_claim", "source": "join_write", "sourceHandle": "out", "target": "claim", "targetHandle": "in" },
      { "id": "e_claim_ok", "source": "claim", "sourceHandle": "success", "target": "wait_writer", "targetHandle": "in" },
      { "id": "e_claim_fail", "source": "claim", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_writer_pending", "source": "wait_writer", "sourceHandle": "pending", "target": "launch_writer", "targetHandle": "in" },
      { "id": "e_writer_out", "source": "wait_writer", "sourceHandle": "out", "target": "writer_ok", "targetHandle": "in" },
      { "id": "e_writer_timeout", "source": "wait_writer", "sourceHandle": "timeout", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_writer_wait_fail", "source": "wait_writer", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_launch_fail", "source": "launch_writer", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_writer_pass", "source": "writer_ok", "sourceHandle": "pass", "target": "writer_complete", "targetHandle": "in" },
      { "id": "e_writer_red", "source": "writer_ok", "sourceHandle": "fail", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_complete_ok", "source": "writer_complete", "sourceHandle": "success", "target": "join_checks", "targetHandle": "in" },
      { "id": "e_complete_fail", "source": "writer_complete", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },

      { "id": "e_checks_join", "source": "join_checks", "sourceHandle": "out", "target": "wait_checks", "targetHandle": "in" },
      { "id": "e_checks_pending", "source": "wait_checks", "sourceHandle": "pending", "target": "checks", "targetHandle": "in" },
      { "id": "e_checks_out", "source": "wait_checks", "sourceHandle": "out", "target": "checks_ok", "targetHandle": "in" },
      { "id": "e_checks_timeout", "source": "wait_checks", "sourceHandle": "timeout", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_checks_wait_fail", "source": "wait_checks", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_checks_http_fail", "source": "checks", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_checks_pass", "source": "checks_ok", "sourceHandle": "pass", "target": "join_round", "targetHandle": "in" },
      { "id": "e_checks_red", "source": "checks_ok", "sourceHandle": "fail", "target": "join_fail", "targetHandle": "in" },

      { "id": "e_round_join", "source": "join_round", "sourceHandle": "out", "target": "visual_evidence", "targetHandle": "in" },
      { "id": "e_visual_ok", "source": "visual_evidence", "sourceHandle": "success", "target": "visual_ok", "targetHandle": "in" },
      { "id": "e_visual_fail", "source": "visual_evidence", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_visual_pass", "source": "visual_ok", "sourceHandle": "pass", "target": "join_report", "targetHandle": "in" },
      { "id": "e_visual_red", "source": "visual_ok", "sourceHandle": "fail", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_report_join", "source": "join_report", "sourceHandle": "out", "target": "report", "targetHandle": "in" },
      { "id": "e_report_ok", "source": "report", "sourceHandle": "success", "target": "done", "targetHandle": "in" },
      { "id": "e_report_fail", "source": "report", "sourceHandle": "failure", "target": "join_fail", "targetHandle": "in" },
      { "id": "e_fail", "source": "join_fail", "sourceHandle": "out", "target": "failed", "targetHandle": "in" }
    ]
  }
}
