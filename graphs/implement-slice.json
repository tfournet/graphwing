{
  "slug": "graphwing-implement-slice",
  "name": "graphwing-implement-slice",
  "description": "Walks a slice index serially. gitStatus → gitCheckout → sliceFrontier → fileHead ticket → agentRun → testRun → sliceComplete → gitCommit/gitPush. On green, sliceContinue POSTs kick_url with the next ticket if the frontier is a build. On red, files stay. Payload: repo, branch, index, optional ticket, commit_message, test, iters_left, optional kick_url.",
  "spec": {
    "meta": { "useSearchAttributes": true },
    "nodes": [
      { "id": "trigger", "type": "trigger.manual", "label": "Start", "position": { "x": 0, "y": 80 }, "config": {} },
      {
        "id": "form",
        "type": "trigger.form",
        "label": "Form",
        "position": { "x": 0, "y": 200 },
        "config": {
          "enabled": true,
          "allowDrafts": false,
          "inputs": {
            "repo": { "type": "string", "required": true },
            "branch": { "type": "string", "required": true },
            "index": { "type": "string", "required": true, "description": "Repo-relative path to slices index JSON" },
            "ticket": { "type": "string", "required": false, "description": "Optional ticket path; must already be on the frontier. Omit to take the next build." },
            "commit_message": { "type": "string", "required": true },
            "test": { "type": "string", "required": true },
            "iters_left": { "type": "string", "required": false, "description": "Set to 2 to resume the same Hermes session with a compact test signal" },
            "class": { "type": "string", "required": false, "description": "mechanical (default), visual, or sensitive" },
            "size": { "type": "string", "required": false, "description": "S, M (default), or L floor" },
            "ac_count": { "type": "string", "required": false },
            "seams": { "type": "string", "required": false },
            "kick_url": { "type": "string", "required": false, "description": "https Rewst webhook for the next slice" },
            "kick_token": { "type": "string", "required": false }
          }
        }
      },
      {
        "id": "hook",
        "type": "trigger.webhook",
        "label": "Webhook",
        "position": { "x": 0, "y": 320 },
        "config": {
          "enabled": true,
          "requireAuthHeader": true,
          "allowedMethods": ["POST"]
        }
      },
      {
        "id": "join_start",
        "type": "logic.join.any",
        "label": "Start from any trigger",
        "position": { "x": 140, "y": 200 },
        "config": { "stopOnFirst": true }
      },
      {
        "id": "git",
        "type": "action.graphwing.GET:/v1/git/status",
        "label": "gitStatus before",
        "position": { "x": 280, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}"
        }
      },
      {
        "id": "checkout",
        "type": "action.graphwing.POST:/v1/git/checkout",
        "label": "gitCheckout",
        "position": { "x": 420, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "branch": "{{ CTX.INPUT.branch }}",
          "create": true
        }
      },
      {
        "id": "frontier",
        "type": "action.graphwing.GET:/v1/slice/frontier",
        "label": "sliceFrontier",
        "position": { "x": 455, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "index": "{{ CTX.INPUT.index }}",
          "ticket": "{{ CTX.INPUT.ticket }}"
        }
      },
      {
        "id": "switch_kind",
        "type": "logic.switch",
        "label": "frontier kind?",
        "position": { "x": 470, "y": 200 },
        "config": {
          "mode": "rules",
          "cases": [
            { "label": "empty", "rules": [{ "path": "data.kind", "op": "equals", "value": "empty" }] },
            { "label": "decision", "rules": [{ "path": "data.kind", "op": "equals", "value": "decision" }] }
          ],
          "default": { "label": "build" }
        }
      },
      {
        "id": "route",
        "type": "action.graphwing.POST:/v1/slice/route",
        "label": "sliceRoute",
        "position": { "x": 480, "y": 40 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 15,
          "class": "{{ CTX.INPUT.class }}",
          "size": "{{ CTX.INPUT.size }}",
          "ac_count": "{{ CTX.INPUT.ac_count }}",
          "seams": "{{ CTX.INPUT.seams }}"
        }
      },
      {
        "id": "review1",
        "type": "action.graphwing.POST:/v1/review/run",
        "label": "specReview 1",
        "position": { "x": 1180, "y": 40 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 200,
          "repo": "{{ CTX.INPUT.repo }}",
          "reviewer": "{{ TASKS.route.data.reviewer1 }}",
          "prompt": "{{ TASKS.ticket_head.data.text }}"
        }
      },
      {
        "id": "if_review1",
        "type": "logic.filter",
        "label": "review1 pass?",
        "position": { "x": 1240, "y": 40 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.ok", "op": "equals", "value": true }]
        }
      },
      {
        "id": "switch_rev",
        "type": "logic.switch",
        "label": "need review?",
        "position": { "x": 1140, "y": 40 },
        "config": {
          "mode": "rules",
          "cases": [
            { "label": "none", "rules": [{ "path": "TASKS.route.data.reviewer1", "op": "equals", "value": "none" }] }
          ],
          "default": { "label": "review" }
        }
      },
      {
        "id": "switch_rev2",
        "type": "logic.switch",
        "label": "need review2?",
        "position": { "x": 1280, "y": 40 },
        "config": {
          "mode": "rules",
          "cases": [
            { "label": "opus", "rules": [{ "path": "TASKS.route.data.reviewer2", "op": "equals", "value": "opus" }] }
          ],
          "default": { "label": "done" }
        }
      },
      {
        "id": "review2",
        "type": "action.graphwing.POST:/v1/review/run",
        "label": "specReview 2",
        "position": { "x": 1320, "y": 40 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 200,
          "repo": "{{ CTX.INPUT.repo }}",
          "reviewer": "opus",
          "prompt": "{{ TASKS.ticket_head.data.text }}"
        }
      },
      {
        "id": "if_review2",
        "type": "logic.filter",
        "label": "review2 pass?",
        "position": { "x": 1360, "y": 40 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.ok", "op": "equals", "value": true }]
        }
      },
      {
        "id": "ticket_head",
        "type": "action.graphwing.GET:/v1/file/head",
        "label": "fileHead ticket",
        "position": { "x": 490, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "path": "{{ TASKS.frontier.data.path }}"
        }
      },
      {
        "id": "wait",
        "type": "action.wait.webhook",
        "label": "Wait for agent receipt",
        "position": { "x": 560, "y": 80 },
        "config": {
          "alias": "wait",
          "allowedMethods": ["POST"],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 960
        }
      },
      {
        "id": "agent",
        "type": "action.graphwing.POST:/v1/agent/run",
        "label": "agentRun",
        "position": { "x": 840, "y": 200 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "cwd": "{{ CTX.INPUT.repo }}",
          "prompt": "{{ TASKS.ticket_head.data.text }}",
          "launcher": "{{ TASKS.route.data.launcher }}",
          "model": "{{ TASKS.route.data.model }}",
          "max_turns": "{{ TASKS.route.data.max_turns }}",
          "run_budget_seconds": "{{ TASKS.route.data.run_budget_seconds }}",
          "response_webhook_url": "{{ TASKS.wait.pending.resumeUrl }}",
          "response_webhook_token": "{{ TASKS.wait.pending.resumeToken }}"
        }
      },
      {
        "id": "record",
        "type": "transforms.objectBuilder",
        "label": "Receipt",
        "position": { "x": 840, "y": 80 },
        "config": {
          "alias": "receipt",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "summary", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.summary" } },
            { "id": "m2", "output": "status", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.status" } },
            { "id": "m3", "output": "job_id", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.job_id" } },
            { "id": "m4", "output": "sha", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.sha" } },
            { "id": "m5", "output": "repo", "expression": { "kind": "getField", "path": "TASKS.git.repo" } },
            { "id": "m6", "output": "branch", "expression": { "kind": "getField", "path": "TASKS.git.branch" } },
            { "id": "m7", "output": "hermes_session", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.hermes_session" } }
          ]
        }
      },
      {
        "id": "test",
        "type": "action.graphwing.POST:/v1/test/run",
        "label": "testRun",
        "position": { "x": 980, "y": 200 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "name": "{{ CTX.INPUT.test }}"
        }
      },
      {
        "id": "if_test_ok",
        "type": "logic.filter",
        "label": "test ok?",
        "position": { "x": 1120, "y": 200 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.ok", "op": "equals", "value": true }]
        }
      },
      {
        "id": "switch_retry",
        "type": "logic.switch",
        "label": "retry once?",
        "position": { "x": 1400, "y": 320 },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "retry",
              "rules": [{ "path": "CTX.INPUT.iters_left", "op": "equals", "value": "2" }]
            }
          ],
          "default": { "label": "stop" }
        }
      },
      {
        "id": "wait2",
        "type": "action.wait.webhook",
        "label": "Wait for retry agent receipt",
        "position": { "x": 1620, "y": 320 },
        "config": {
          "alias": "wait2",
          "allowedMethods": ["POST"],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 960
        }
      },
      {
        "id": "agent2",
        "type": "action.graphwing.POST:/v1/agent/run",
        "label": "retry agentRun",
        "position": { "x": 1840, "y": 440 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "cwd": "{{ CTX.INPUT.repo }}",
          "hermes_session": "{{ TASKS.wait.request.body.hermes_session }}",
          "launcher": "{{ TASKS.route.data.launcher }}",
          "model": "{{ TASKS.route.data.model }}",
          "max_turns": "{{ TASKS.route.data.max_turns }}",
          "run_budget_seconds": "{{ TASKS.route.data.run_budget_seconds }}",
          "prompt": "{{ TASKS.ticket_head.data.text }}\n\nNAMED TESTS FAILED. Compact signal:\n{{ TASKS.test.data.compact }}\nFiles are on disk. Continue this slice in the same Hermes session. Do not restart from a blank plan.",
          "response_webhook_url": "{{ TASKS.wait2.pending.resumeUrl }}",
          "response_webhook_token": "{{ TASKS.wait2.pending.resumeToken }}"
        }
      },
      {
        "id": "record2",
        "type": "transforms.objectBuilder",
        "label": "Retry receipt",
        "position": { "x": 1840, "y": 320 },
        "config": {
          "alias": "receipt2",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "summary", "expression": { "kind": "getField", "path": "TASKS.wait2.request.body.summary" } },
            { "id": "m2", "output": "status", "expression": { "kind": "getField", "path": "TASKS.wait2.request.body.status" } },
            { "id": "m3", "output": "job_id", "expression": { "kind": "getField", "path": "TASKS.wait2.request.body.job_id" } },
            { "id": "m4", "output": "sha", "expression": { "kind": "getField", "path": "TASKS.wait2.request.body.sha" } },
            { "id": "m5", "output": "repo", "expression": { "kind": "getField", "path": "TASKS.git.repo" } },
            { "id": "m6", "output": "branch", "expression": { "kind": "getField", "path": "TASKS.git.branch" } }
          ]
        }
      },
      {
        "id": "test2",
        "type": "action.graphwing.POST:/v1/test/run",
        "label": "retry testRun",
        "position": { "x": 2060, "y": 320 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "name": "{{ CTX.INPUT.test }}"
        }
      },
      {
        "id": "if_test_ok2",
        "type": "logic.filter",
        "label": "retry test ok?",
        "position": { "x": 2280, "y": 320 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.ok", "op": "equals", "value": true }]
        }
      },
      {
        "id": "wait_human",
        "type": "action.wait.webhook",
        "label": "Wait for human (files kept)",
        "position": { "x": 1620, "y": 560 },
        "config": {
          "alias": "human",
          "allowedMethods": ["POST"],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 60
        }
      },
      {
        "id": "human_ack",
        "type": "transforms.objectBuilder",
        "label": "Human acknowledged",
        "position": { "x": 1840, "y": 560 },
        "config": {
          "alias": "human_ack",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "literal", "value": "ok" } },
            { "id": "m2", "output": "reason", "expression": { "kind": "literal", "value": "human_acked" } }
          ]
        }
      },
      {
        "id": "commit",
        "type": "action.graphwing.POST:/v1/git/commit",
        "label": "gitCommit",
        "position": { "x": 1120, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "message": "{{ CTX.INPUT.commit_message }}",
          "add": "{{ CTX.INPUT.index }}"
        }
      },
      {
        "id": "complete",
        "type": "action.graphwing.POST:/v1/slice/complete",
        "label": "sliceComplete",
        "position": { "x": 1080, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "index": "{{ CTX.INPUT.index }}",
          "id": "{{ TASKS.frontier.data.id }}"
        }
      },
      {
        "id": "walk",
        "type": "action.graphwing.POST:/v1/slice/continue",
        "label": "sliceContinue",
        "position": { "x": 1540, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "index": "{{ CTX.INPUT.index }}",
          "branch": "{{ CTX.INPUT.branch }}",
          "test": "{{ CTX.INPUT.test }}",
          "commit_message": "{{ CTX.INPUT.commit_message }}",
          "iters_left": "{{ CTX.INPUT.iters_left }}",
          "class": "{{ CTX.INPUT.class }}",
          "size": "{{ CTX.INPUT.size }}",
          "ac_count": "{{ CTX.INPUT.ac_count }}",
          "seams": "{{ CTX.INPUT.seams }}",
          "kick_url": "{{ CTX.INPUT.kick_url }}",
          "kick_token": "{{ CTX.INPUT.kick_token }}"
        }
      },
      {
        "id": "switch_walk",
        "type": "logic.switch",
        "label": "next kind?",
        "position": { "x": 1610, "y": 80 },
        "config": {
          "mode": "rules",
          "cases": [
            { "label": "empty", "rules": [{ "path": "data.kind", "op": "equals", "value": "empty" }] },
            { "label": "decision", "rules": [{ "path": "data.kind", "op": "equals", "value": "decision" }] }
          ],
          "default": { "label": "build" }
        }
      },
      {
        "id": "join_commit",
        "type": "logic.join.any",
        "label": "Commit after any test pass",
        "position": { "x": 2500, "y": 80 },
        "config": { "stopOnFirst": true }
      },
      {
        "id": "push",
        "type": "action.graphwing.POST:/v1/git/push",
        "label": "gitPush",
        "position": { "x": 1400, "y": 80 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "remote": "origin",
          "ref": "{{ CTX.INPUT.branch }}"
        }
      },
      { "id": "commit_fail", "type": "action.noop", "label": "Herdr: commit failed", "position": { "x": 1120, "y": -160 }, "config": {} },
      { "id": "push_fail", "type": "action.noop", "label": "Herdr: push failed", "position": { "x": 1400, "y": -160 }, "config": {} },
      {
        "id": "done",
        "type": "transforms.objectBuilder",
        "label": "Done",
        "position": { "x": 1680, "y": 80 },
        "config": {
          "alias": "done",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "literal", "value": "ok" } },
            { "id": "m2", "output": "repo", "expression": { "kind": "getField", "path": "CTX.INPUT.repo" } },
            { "id": "m3", "output": "branch", "expression": { "kind": "getField", "path": "CTX.INPUT.branch" } }
          ]
        }
      },
      { "id": "timeout", "type": "action.noop", "label": "Wait timeout", "position": { "x": 840, "y": -40 }, "config": {} },
      { "id": "fail", "type": "action.noop", "label": "Wait failure", "position": { "x": 840, "y": -160 }, "config": {} },
      { "id": "checkout_fail", "type": "action.noop", "label": "Herdr: checkout failed", "position": { "x": 420, "y": -160 }, "config": {} },
      { "id": "ticket_fail", "type": "action.noop", "label": "Herdr: ticket fileHead failed", "position": { "x": 490, "y": -160 }, "config": {} },
      { "id": "frontier_fail", "type": "action.noop", "label": "Herdr: sliceFrontier failed", "position": { "x": 455, "y": -160 }, "config": {} },
      { "id": "complete_fail", "type": "action.noop", "label": "Herdr: sliceComplete failed", "position": { "x": 1080, "y": -160 }, "config": {} },
      { "id": "walk_fail", "type": "action.noop", "label": "Herdr: sliceContinue failed", "position": { "x": 1540, "y": -160 }, "config": {} },
      { "id": "slices_complete", "type": "action.noop", "label": "Herdr: slices complete", "position": { "x": 1680, "y": 200 }, "config": {} },
      { "id": "route_fail", "type": "action.noop", "label": "Herdr: sliceRoute failed", "position": { "x": 480, "y": -160 }, "config": {} },
      { "id": "review_fail", "type": "action.noop", "label": "Herdr: specReview HTTP failed", "position": { "x": 1180, "y": -160 }, "config": {} },
      { "id": "test_http_fail", "type": "action.noop", "label": "Herdr: testRun HTTP failed", "position": { "x": 1120, "y": 320 }, "config": {} },

      { "id": "wait2_timeout", "type": "action.noop", "label": "Herdr: retry wait timeout", "position": { "x": 1840, "y": 200 }, "config": {} },
      { "id": "wait2_fail", "type": "action.noop", "label": "Herdr: retry wait failure", "position": { "x": 1840, "y": 80 }, "config": {} },
      { "id": "test2_http_fail", "type": "action.noop", "label": "Herdr: retry testRun HTTP failed", "position": { "x": 2280, "y": 200 }, "config": {} },
      { "id": "herdr_waiting", "type": "action.noop", "label": "Herdr: waiting for human; files kept", "position": { "x": 1840, "y": 680 }, "config": {} },
      { "id": "nack_timeout", "type": "action.noop", "label": "Herdr: human timeout", "position": { "x": 1840, "y": 800 }, "config": {} }
    ],
    "edges": [
      { "id": "e_start_trigger", "source": "trigger", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_form", "source": "form", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_hook", "source": "hook", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_git", "source": "join_start", "sourceHandle": "out", "target": "git", "targetHandle": "in" },
      { "id": "e2", "source": "git", "sourceHandle": "success", "target": "checkout", "targetHandle": "in" },
      { "id": "e3", "source": "wait", "sourceHandle": "pending", "target": "agent", "targetHandle": "in" },
      { "id": "e4", "source": "wait", "sourceHandle": "out", "target": "record", "targetHandle": "in" },
      { "id": "e5", "source": "wait", "sourceHandle": "timeout", "target": "timeout", "targetHandle": "in" },
      { "id": "e6", "source": "wait", "sourceHandle": "failure", "target": "fail", "targetHandle": "in" },
      { "id": "e7", "source": "checkout", "sourceHandle": "success", "target": "frontier", "targetHandle": "in" },
      { "id": "e7f", "source": "frontier", "sourceHandle": "success", "target": "switch_kind", "targetHandle": "in" },
      { "id": "e7g", "source": "frontier", "sourceHandle": "failure", "target": "frontier_fail", "targetHandle": "in" },
      { "id": "e7h", "source": "switch_kind", "sourceHandle": "case-0", "target": "slices_complete", "targetHandle": "in" },
      { "id": "e7i", "source": "switch_kind", "sourceHandle": "case-1", "target": "wait_human", "targetHandle": "in" },
      { "id": "e7j", "source": "switch_kind", "sourceHandle": "default", "target": "route", "targetHandle": "in" },
      { "id": "e7k", "source": "route", "sourceHandle": "success", "target": "ticket_head", "targetHandle": "in" },
      { "id": "e7m", "source": "route", "sourceHandle": "failure", "target": "route_fail", "targetHandle": "in" },
      { "id": "e7b", "source": "ticket_head", "sourceHandle": "success", "target": "wait", "targetHandle": "in" },
      { "id": "e7c", "source": "ticket_head", "sourceHandle": "failure", "target": "ticket_fail", "targetHandle": "in" },
