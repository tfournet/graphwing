{
  "slug": "graphwing-pr-drive",
  "name": "graphwing-pr-drive",
  "description": "Hard-coded PR driver using the declared trigger inputs documented in the catalog: one bounded run reserves and settles each attempt through a capped in-run retry loop (up to three slots; a slot re-reads the PR and does nothing once green), then one final head-bound named test and persisted evidence gate before optional merge. Every attempt is run-control reservation-backed; start after graphwing-run-control-initialize with run_control_id. The webhook/doorbell start is a known-disabled operator path because current webhook runs do not create CTX.INPUT.",
  "spec": {
    "meta": {
      "useSearchAttributes": true
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.manual",
        "config": {}
      },
      {
        "id": "form",
        "type": "trigger.form",
        "label": "Form",
        "position": {
          "x": 0,
          "y": 360
        },
        "config": {
          "enabled": true,
          "allowDrafts": false,
          "inputs": {
            "repo": {
              "type": "string",
              "required": true
            },
            "pr_number": {
              "type": "string",
              "required": true,
              "description": "PR number. Named pr_number because a plain pr input never reaches the workflow input context."
            },
            "auto_merge": {
              "type": "string",
              "required": false
            },
            "test": {
              "type": "string",
              "required": true
            },
            "class": {
              "type": "string",
              "required": false,
              "description": "mechanical | visual | sensitive; absent means mechanical"
            },
            "size": {
              "type": "string",
              "required": false
            },
            "work_kind": {
              "type": "string",
              "required": false,
              "description": "go_coding, typescript_coding, or research_ops; absent preserves the existing Codex route"
            },
            "prompt": {
              "type": "string",
              "required": false
            },
            "commit_message": {
              "type": "string",
              "required": true
            },
            "run_control_id": {
              "type": "string",
              "required": true,
              "description": "graphwing-run-control-initialize's identity for this PR-drive attempt."
            }
          }
        }
      },
      {
        "id": "hook",
        "type": "trigger.webhook",
        "label": "Webhook",
        "position": {
          "x": 0,
          "y": 480
        },
        "config": {
          "enabled": true,
          "requireAuthHeader": true,
          "headerKey": "x-rewst-secret",
          "headerValue": "$GRAPHWING_HOOK_SECRET",
          "allowedMethods": [
            "POST"
          ]
        }
      },
      {
        "id": "join_start",
        "type": "logic.join.any",
        "config": {}
      },
      {
        "id": "run_input",
        "type": "transforms.objectBuilder",
        "config": {
          "alias": "run_input",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "repo",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.repo"
              }
            },
            {
              "id": "m2",
              "output": "pr_number",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.pr_number"
              }
            },
            {
              "id": "m3",
              "output": "test",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.test"
              }
            },
            {
              "id": "m4",
              "output": "auto_merge",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.auto_merge"
              }
            },
            {
              "id": "m5",
              "output": "class",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.class"
              }
            },
            {
              "id": "m6",
              "output": "size",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.size"
              }
            },
            {
              "id": "m7",
              "output": "work_kind",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.work_kind"
              }
            },
            {
              "id": "m8",
              "output": "prompt",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.prompt"
              }
            },
            {
              "id": "m9",
              "output": "commit_message",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.commit_message"
              }
            },
            {
              "id": "m10",
              "output": "run_control_id",
              "expression": {
                "kind": "getField",
                "path": "CTX.INPUT.run_control_id"
              }
            }
          ]
        }
      },
      {
        "id": "git",
        "type": "action.graphwing.GET:/v1/git/status",
        "label": "gitStatus",
        "position": {
          "x": 220,
          "y": 240
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}"
        }
      },
      {
        "id": "view",
        "type": "action.graphwing.GET:/v1/gh/pr/view",
        "label": "ghPrView",
        "position": {
          "x": 440,
          "y": 240
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}",
          "number": "{{ CTX.run_input.pr_number }}"
        }
      },
      {
        "id": "route",
        "type": "action.graphwing.POST:/v1/slice/route",
        "label": "sliceRoute",
        "position": {
          "x": 1180,
          "y": 240
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 15,
          "class": "{{ CTX.run_input.class }}",
          "work_kind": "{{ CTX.run_input.work_kind | default('go_coding') }}",
          "size": "{{ CTX.run_input.size }}"
        }
      },
      {
        "id": "attempt_slots",
        "type": "transforms.objectBuilder",
        "config": {
          "alias": "attempt_slots",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "slots",
              "expression": {
                "kind": "literal",
                "value": [
                  1,
                  2,
                  3
                ]
              }
            }
          ]
        }
      },
      {
        "id": "attempts",
        "type": "logic.loop",
        "config": {
          "alias": "attempts",
          "arraySource": "{{ CTX.attempt_slots.slots }}",
          "batchSize": 1,
          "concurrency": 1,
          "maxIterations": 3
        }
      },
      {
        "id": "herdr_git",
        "type": "action.noop",
        "label": "Herdr: gitStatus failed",
        "config": {}
      },
      {
        "id": "herdr_no_pr",
        "type": "action.noop",
        "label": "Herdr: missing PR",
        "config": {}
      },
      {
        "id": "herdr_route",
        "type": "action.noop",
        "label": "Herdr: sliceRoute failed",
        "config": {}
      },
      {
        "id": "iter_findings",
        "type": "action.graphwing.GET:/v1/gh/pr/findings",
        "label": "PR findings",
        "position": {
          "x": 1180,
          "y": 380
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}",
          "number": "{{ CTX.run_input.pr_number }}"
        }
      },
      {
        "id": "iter_snap",
        "type": "transforms.objectBuilder",
        "config": {
          "alias": "iter_snap",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "all_green",
              "expression": {
                "kind": "getField",
                "path": "TASKS.iter_findings.data.all_green"
              }
            },
            {
              "id": "m2",
              "output": "attempt",
              "expression": {
                "kind": "getField",
                "path": "ITEM"
              }
            }
          ]
        }
      },
      {
        "id": "switch_needs_fix",
        "type": "logic.switch",
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "red",
              "rules": [
                {
                  "path": "all_green",
                  "op": "equals",
                  "value": false
                }
              ]
            }
          ],
          "default": {
            "label": "not_red"
          }
        }
      },
      {
        "id": "iter_skip",
        "type": "action.noop",
        "config": {}
      },
      {
        "id": "iter_checkout",
        "type": "action.graphwing.POST:/v1/git/checkout",
        "label": "Checkout PR head",
        "position": {
          "x": 1320,
          "y": 240
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}",
          "branch": "{{ TASKS.view.data.data.headRefName }}",
          "create": false
        }
      },
      {
        "id": "rc_task_material",
        "type": "transforms.objectBuilder",
        "config": {
          "alias": "rc_task_material",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "task",
              "expression": {
                "kind": "object",
                "properties": {
                  "kind": {
                    "kind": "literal",
                    "value": "pr-drive-loop"
                  },
                  "repo": {
                    "kind": "getField",
                    "path": "CTX.run_input.repo"
                  },
                  "pr_number": {
                    "kind": "getField",
                    "path": "CTX.run_input.pr_number"
                  },
                  "test": {
                    "kind": "getField",
                    "path": "CTX.run_input.test"
                  },
                  "attempt": {
                    "kind": "getField",
                    "path": "ITEM"
                  }
                }
              }
            },
            {
              "id": "m2",
              "output": "callback",
              "expression": {
                "kind": "object",
                "properties": {
                  "kind": {
                    "kind": "literal",
                    "value": "in-run"
                  }
                }
              }
            },
            {
              "id": "m3",
              "output": "candidate_route",
              "expression": {
                "kind": "object",
                "properties": {
                  "route_version": {
                    "kind": "getField",
                    "path": "TASKS.route.data.route_version"
                  },
                  "launcher": {
                    "kind": "getField",
                    "path": "TASKS.route.data.launcher"
                  },
                  "provider": {
                    "kind": "getField",
                    "path": "TASKS.route.data.provider"
                  },
                  "model": {
                    "kind": "getField",
                    "path": "TASKS.route.data.model"
                  }
                }
              }
            },
            {
              "id": "m4",
              "output": "next_envelope",
              "expression": {
                "kind": "object",
                "properties": {
                  "turns": {
                    "kind": "literal",
                    "value": 50
                  },
                  "wall_seconds": {
                    "kind": "literal",
                    "value": 660
                  },
                  "tokens": {
                    "kind": "literal",
                    "value": 2000000
                  },
                  "provider_cost_usd": {
                    "kind": "literal",
                    "value": "25"
                  }
                }
              }
            },
            {
              "id": "m5",
              "output": "handoff",
              "expression": {
                "kind": "object",
                "properties": {
                  "reason_code": {
                    "kind": "literal",
                    "value": "provider_switch"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "id": "rc_task_hash",
        "type": "transforms.hash",
        "config": {
          "alias": "rc_task_hash",
          "mode": "hash",
          "algorithm": "sha256",
          "inputKind": "json_stringify",
          "input": "{{ CTX.rc_task_material.task }}",
          "outputFormat": "hex",
          "hexCase": "lower"
        }
      },
      {
        "id": "rc_callback_hash",
        "type": "transforms.hash",
        "config": {
          "alias": "rc_callback_hash",
          "mode": "hash",
          "algorithm": "sha256",
          "inputKind": "json_stringify",
          "input": "{{ CTX.rc_task_material.callback }}",
          "outputFormat": "hex",
          "hexCase": "lower"
        }
      },
      {
        "id": "rc_state",
        "type": "action.subworkflow",
        "config": {
          "alias": "rc_state",
          "workflowId": "$GRAPHWING_RUN_CONTROL_STATE_WORKFLOW_ID",
          "workflowVersionId": "$GRAPHWING_RUN_CONTROL_STATE_VERSION_ID",
          "inputMapping": {
            "mode": "select",
            "values": {
              "run_control_id": "{{ CTX.run_input.run_control_id }}",
              "candidate_route": "{{ CTX.rc_task_material.candidate_route }}",
              "next_envelope": "{{ CTX.rc_task_material.next_envelope }}",
              "launcher_fingerprint": "graphwing-loop-attempt-v1",
              "endpoint": "/v1/agent/run",
              "exact_request_body_sha256": "{{ CTX.rc_task_hash.value }}",
              "repository": "{{ CTX.run_input.repo }}",
              "branch": "{{ TASKS.view.data.data.headRefName }}",
              "head_sha": "{{ TASKS.view.data.data.headRefOid }}",
              "task_sha256": "{{ CTX.rc_task_hash.value }}",
              "permission_profile": "pr-drive-writer-v1",
              "callback_binding_sha256": "{{ CTX.rc_callback_hash.value }}",
              "handoff": "{{ CTX.rc_task_material.handoff }}"
            }
          },
          "outputMapping": {
            "mode": "select",
            "keys": [
              "transition_result",
              "attempt_identity",
              "reservation_parts",
              "descriptor_hash"
            ]
          },
          "timeout": 2400
        }
      },
      {
        "id": "rc_consume",
        "type": "action.subworkflow",
        "config": {
          "alias": "rc_consume",
          "workflowId": "$GRAPHWING_RUN_CONTROL_CONSUME_WORKFLOW_ID",
          "workflowVersionId": "$GRAPHWING_RUN_CONTROL_CONSUME_VERSION_ID",
          "inputMapping": {
            "mode": "select",
            "values": {
              "run_control_id": "{{ CTX.run_input.run_control_id }}"
            }
          },
          "outputMapping": {
            "mode": "select",
            "keys": [
              "transition_result",
              "consume_result"
            ]
          },
          "timeout": 2400
        }
      },
      {
        "id": "rc_continuity",
        "type": "transforms.objectBuilder",
        "config": {
          "alias": "rc_continuity",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "run_control",
              "expression": {
                "kind": "object",
                "properties": {
                  "run_control_id": {
                    "kind": "getField",
                    "path": "CTX.run_input.run_control_id"
                  },
                  "attempt_id": {
                    "kind": "getField",
                    "path": "TASKS.rc_state.result.attempt_identity.attempt_id"
                  },
                  "authorization_id": {
                    "kind": "getField",
                    "path": "TASKS.rc_state.result.attempt_identity.authorization_id"
                  },
                  "launch_descriptor_sha256": {
                    "kind": "getField",
                    "path": "TASKS.rc_state.result.descriptor_hash.value"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "id": "wait",
        "type": "action.wait.webhook",
        "label": "Wait for agent receipt",
        "position": {
          "x": 1760,
          "y": 240
        },
        "config": {
          "alias": "wait",
          "allowedMethods": [
            "POST"
          ],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 960
        }
      },
      {
        "id": "agent",
        "type": "action.graphwing.POST:/v1/agent/run",
        "label": "implement-slice agentRun",
        "position": {
          "x": 1980,
          "y": 400
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "cwd": "{{ CTX.run_input.repo }}",
          "prompt": "{{ TASKS.iter_findings.data.brief | default(CTX.run_input.prompt) }}",
          "launcher": "{{ TASKS.route.data.launcher }}",
          "provider": "{{ TASKS.route.data.provider }}",
          "model": "{{ TASKS.route.data.model }}",
          "effort": "{{ TASKS.route.data.effort }}",
          "route_execution_profile": "{{ TASKS.route.data.writer_execution_profile }}",
          "_comment": "Without these the writer takes AGENT_RUN_BUDGET=300 and is SIGINTed at 300+60. Three laps ran 260s, 335s and 363s, so a fix round is L-sized work, not M. wait is 960, which clears 600+60 with room.",
          "max_turns": "50",
          "run_budget_seconds": "600",
          "response_webhook_url": "{{ TASKS.wait.pending.resumeUrl }}",
          "response_webhook_token": "{{ TASKS.wait.pending.resumeToken }}",
          "run_control": "{{ CTX.rc_continuity.run_control }}"
        }
      },
      {
        "id": "rc_settle",
        "type": "action.graphwing.POST:/v1/run/control/settle",
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "run_control": "{{ CTX.rc_continuity.run_control }}",
          "receipt": "{{ TASKS.wait.request.body }}"
        }
      },
      {
        "id": "rc_reconcile",
        "type": "action.subworkflow",
        "config": {
          "alias": "rc_reconcile",
          "workflowId": "$GRAPHWING_RUN_CONTROL_RECONCILE_WORKFLOW_ID",
          "workflowVersionId": "$GRAPHWING_RUN_CONTROL_RECONCILE_VERSION_ID",
          "inputMapping": {
            "mode": "select",
            "values": {
              "run_control_id": "{{ CTX.run_input.run_control_id }}",
              "kind": "{{ TASKS.rc_settle.data.kind }}",
              "receipt": "{{ TASKS.rc_settle.data.receipt }}",
              "authority_loss_reason": "{{ TASKS.rc_settle.data.authority_loss_reason }}"
            }
          },
          "outputMapping": {
            "mode": "select",
            "keys": [
              "transition_result"
            ]
          },
          "timeout": 2400
        }
      },
      {
        "id": "receipt",
        "type": "transforms.objectBuilder",
        "label": "Receipt",
        "position": {
          "x": 1980,
          "y": 240
        },
        "config": {
          "alias": "receipt",
          "version": 1,
          "mappings": [
            {
              "id": "m1",
              "output": "status",
              "expression": {
                "kind": "getField",
                "path": "TASKS.wait.request.body.status"
              }
            },
            {
              "id": "m2",
              "output": "summary",
              "expression": {
                "kind": "getField",
                "path": "TASKS.wait.request.body.summary"
              }
            },
            {
              "id": "m3",
              "output": "job_id",
              "expression": {
                "kind": "getField",
                "path": "TASKS.wait.request.body.job_id"
              }
            },
            {
              "id": "m4",
              "output": "sha",
              "expression": {
                "kind": "getField",
                "path": "TASKS.wait.request.body.sha"
              }
            },
            {
              "id": "m5",
              "output": "route",
              "expression": {
                "kind": "getField",
                "path": "TASKS.route.data"
              }
            }
          ]
        }
      },
      {
        "id": "switch_receipt_ok",
        "type": "logic.switch",
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "ok",
              "rules": [
                {
                  "path": "status",
                  "op": "equals",
                  "value": "ok"
                }
              ]
            }
          ],
          "default": {
            "label": "not_ok"
          }
        }
      },
      {
        "id": "wait_fix_test",
        "type": "action.wait.webhook",
        "label": "Wait fix test",
        "position": {
          "x": 2420,
          "y": 380
        },
        "config": {
          "alias": "wait_fix_test",
          "allowedMethods": [
            "POST"
          ],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 960
        }
      },
      {
        "id": "fix_test",
        "type": "action.graphwing.POST:/v1/test/run",
        "label": "testRun after fix",
        "position": {
          "x": 2420,
          "y": 240
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "name": "{{ CTX.run_input.test }}",
          "response_webhook_url": "{{ TASKS.wait_fix_test.pending.resumeUrl }}",
          "response_webhook_token": "{{ TASKS.wait_fix_test.pending.resumeToken }}"
        }
      },
      {
        "id": "switch_fix_test",
        "type": "logic.switch",
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "ok",
              "rules": [
                {
                  "path": "request.body.status",
                  "op": "equals",
                  "value": "ok"
                }
              ]
            }
          ],
          "default": {
            "label": "not_ok"
          }
        }
      },
      {
        "id": "fix_commit",
        "type": "action.graphwing.POST:/v1/git/commit",
        "label": "Commit fix",
        "position": {
          "x": 2860,
          "y": 160
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}",
          "message": "{{ CTX.run_input.commit_message | default('fix: address review findings') }}",
          "writer_job_id": "{{ CTX.receipt.job_id }}"
        }
      },
      {
        "id": "fix_push",
        "type": "action.graphwing.POST:/v1/git/push",
        "label": "Push fix",
        "position": {
          "x": 3080,
          "y": 160
        },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.run_input.repo }}",
          "remote": "origin",
          "ref": "{{ TASKS.view.data.data.headRefName }}"
        }
      },
      {
        "id": "herdr_pr_checkout",
        "type": "action.noop",
        "label": "Herdr: PR checkout failed",
        "config": {}
      },
      {
        "id": "herdr_wait_timeout",
        "type": "action.noop",
        "label": "Herdr: agent wait timeout",
        "config": {}
      },
      {
        "id": "herdr_wait_fail",
        "type": "action.noop",
        "label": "Herdr: agent wait failure",
        "config": {}
      },
      {
        "id": "herdr_receipt",
        "type": "action.noop",
        "label": "Herdr: receipt not ok",
        "config": {}
      },
      {
        "id": "herdr_test_http",
        "type": "action.noop",
        "label": "Herdr: testRun HTTP failed",
        "config": {}
      },
      {
        "id": "herdr_test_fail",
        "type": "action.noop",
        "label": "Herdr: testRun not ok; files kept",
        "config": {}
      },
      {
        "id": "herdr_commit",
        "type": "action.noop",
        "label": "Herdr: commit failed",
        "config": {}
