{
  "slug": "graphwing-pr-drive",
  "name": "graphwing-pr-drive",
  "description": "Hard-coded PR driver: gitStatus → ghPrView → ghPrChecks. Green + reviews_ok is mergeable; red drives one fix slice; pending or blocking reviews stop at a unique Herdr noop. Doorbell is the authenticated webhook. Payload: repo, pr, test, prompt, commit_message.",
  "spec": {
    "meta": { "useSearchAttributes": true },
    "nodes": [
      { "id": "trigger", "type": "trigger.manual", "label": "Start", "position": { "x": 0, "y": 240 }, "config": {} },
      {
        "id": "form",
        "type": "trigger.form",
        "label": "Form",
        "position": { "x": 0, "y": 360 },
        "config": {
          "enabled": true,
          "allowDrafts": false,
          "inputs": {
            "repo": { "type": "string", "required": true },
            "pr": { "type": "string", "required": true },
            "test": { "type": "string", "required": true },
            "prompt": { "type": "string", "required": true },
            "commit_message": { "type": "string", "required": true }
          }
        }
      },
      {
        "id": "hook",
        "type": "trigger.webhook",
        "label": "Webhook",
        "position": { "x": 0, "y": 480 },
        "config": {
          "enabled": true,
          "requireAuthHeader": true,
          "headerKey": "x-rewst-secret",
          "headerValue": "$GRAPHWING_HOOK_SECRET",
          "allowedMethods": ["POST"]
        }
      },
      {
        "id": "join_start",
        "type": "logic.join.any",
        "label": "Start from any trigger",
        "position": { "x": 110, "y": 360 },
        "config": { "stopOnFirst": true }
      },
      {
        "id": "git",
        "type": "action.graphwing.GET:/v1/git/status",
        "label": "gitStatus",
        "position": { "x": 220, "y": 240 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}"
        }
      },
      {
        "id": "view",
        "type": "action.graphwing.GET:/v1/gh/pr/view",
        "label": "ghPrView",
        "position": { "x": 440, "y": 240 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "checks",
        "type": "action.graphwing.GET:/v1/gh/pr/checks",
        "label": "ghPrChecks",
        "position": { "x": 660, "y": 240 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "switch_checks",
        "type": "logic.switch",
        "label": "checks green/red/pending",
        "position": { "x": 880, "y": 240 },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "green",
              "rules": [{ "path": "data.all_green", "op": "equals", "value": true }]
            },
            {
              "label": "red",
              "rules": [{ "path": "data.any_red", "op": "equals", "value": true }]
            }
          ],
          "default": { "label": "pending" }
        }
      },
      {
        "id": "review_snap",
        "type": "transforms.objectBuilder",
        "label": "Review snapshot",
        "position": { "x": 1100, "y": 80 },
        "config": {
          "alias": "review_snap",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "review_decision", "expression": { "kind": "getField", "path": "TASKS.view.data.review_decision" } },
            { "id": "m2", "output": "reviews_blocking", "expression": { "kind": "getField", "path": "TASKS.view.data.reviews_blocking" } }
          ]
        }
      },
      {
        "id": "switch_review",
        "type": "logic.switch",
        "label": "reviews blocking?",
        "position": { "x": 1320, "y": 80 },
        "config": {
          "mode": "rules",
          "cases": [
            {
              "label": "changes",
              "rules": [{ "path": "review_decision", "op": "equals", "value": "CHANGES_REQUESTED" }]
            },
            {
              "label": "need_review",
              "rules": [{ "path": "review_decision", "op": "equals", "value": "REVIEW_REQUIRED" }]
            }
          ],
          "default": { "label": "mergeable" }
        }
      },
      {
        "id": "done_mergeable",
        "type": "transforms.objectBuilder",
        "label": "Done (mergeable)",
        "position": { "x": 1540, "y": 80 },
        "config": {
          "alias": "done_mergeable",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "literal", "value": "ok" } },
            { "id": "m2", "output": "reason", "expression": { "kind": "literal", "value": "mergeable" } },
            { "id": "m3", "output": "repo", "expression": { "kind": "getField", "path": "CTX.INPUT.repo" } },
            { "id": "m4", "output": "pr", "expression": { "kind": "getField", "path": "CTX.INPUT.pr" } }
          ]
        }
      },
      {
        "id": "pr_checkout",
        "type": "action.graphwing.POST:/v1/git/checkout",
        "label": "Checkout PR head",
        "position": { "x": 1320, "y": 240 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "branch": "{{ TASKS.view.data.data.headRefName }}",
          "create": false
        }
      },
      {
        "id": "wait",
        "type": "action.wait.webhook",
        "label": "Wait for agent receipt",
        "position": { "x": 1760, "y": 240 },
        "config": {
          "alias": "wait",
          "allowedMethods": ["POST"],
          "authMode": "token",
          "responseStatus": 200,
          "timeoutSeconds": 300
        }
      },
      {
        "id": "agent",
        "type": "action.graphwing.POST:/v1/agent/run",
        "label": "implement-slice agentRun",
        "position": { "x": 1980, "y": 400 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "cwd": "{{ CTX.INPUT.repo }}",
          "prompt": "{{ CTX.INPUT.prompt }}",
          "response_webhook_url": "{{ TASKS.wait.pending.resumeUrl }}",
          "response_webhook_token": "{{ TASKS.wait.pending.resumeToken }}"
        }
      },
      {
        "id": "receipt",
        "type": "transforms.objectBuilder",
        "label": "Receipt",
        "position": { "x": 1980, "y": 240 },
        "config": {
          "alias": "receipt",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.status" } },
            { "id": "m2", "output": "summary", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.summary" } },
            { "id": "m3", "output": "job_id", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.job_id" } },
            { "id": "m4", "output": "sha", "expression": { "kind": "getField", "path": "TASKS.wait.request.body.sha" } }
          ]
        }
      },
      {
        "id": "if_receipt_ok",
        "type": "logic.filter",
        "label": "receipt ok?",
        "position": { "x": 2200, "y": 240 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "status", "op": "equals", "value": "ok" }]
        }
      },
      {
        "id": "fix_test",
        "type": "action.graphwing.POST:/v1/test/run",
        "label": "testRun after fix",
        "position": { "x": 2420, "y": 240 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 60,
          "name": "{{ CTX.INPUT.test }}"
        }
      },
      {
        "id": "if_fix_test",
        "type": "logic.filter",
        "label": "fix test ok?",
        "position": { "x": 2640, "y": 240 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.ok", "op": "equals", "value": true }]
        }
      },
      {
        "id": "fix_commit",
        "type": "action.graphwing.POST:/v1/git/commit",
        "label": "Commit fix",
        "position": { "x": 2860, "y": 160 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "message": "{{ CTX.INPUT.commit_message }}"
        }
      },
      {
        "id": "fix_push",
        "type": "action.graphwing.POST:/v1/git/push",
        "label": "Push fix",
        "position": { "x": 3080, "y": 160 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "remote": "origin",
          "ref": "{{ TASKS.view.data.data.headRefName }}"
        }
      },

      {
        "id": "checks2",
        "type": "action.graphwing.GET:/v1/gh/pr/checks",
        "label": "ghPrChecks after fix",
        "position": { "x": 3300, "y": 160 },
        "config": {
          "integrationInstanceId": "$GRAPHWING_INSTANCE",
          "timeout": 30,
          "repo": "{{ CTX.INPUT.repo }}",
          "number": "{{ CTX.INPUT.pr }}"
        }
      },
      {
        "id": "if_green2",
        "type": "logic.filter",
        "label": "all_green after fix?",
        "position": { "x": 3520, "y": 160 },
        "config": {
          "group": "AND",
          "rules": [{ "path": "data.all_green", "op": "equals", "value": true }]
        }
      },
      {
        "id": "done_after_fix",
        "type": "transforms.objectBuilder",
        "label": "Done after one fix",
        "position": { "x": 3740, "y": 80 },
        "config": {
          "alias": "done_after_fix",
          "version": 1,
          "mappings": [
            { "id": "m1", "output": "status", "expression": { "kind": "literal", "value": "ok" } },
            { "id": "m2", "output": "reason", "expression": { "kind": "literal", "value": "checks_green_after_fix" } },
            { "id": "m3", "output": "job_id", "expression": { "kind": "getField", "path": "CTX.receipt.job_id" } }
          ]
        }
      },
      { "id": "herdr_no_pr", "type": "action.noop", "label": "Herdr: missing PR", "position": { "x": 660, "y": 480 }, "config": {} },
      { "id": "herdr_git", "type": "action.noop", "label": "Herdr: gitStatus failed", "position": { "x": 440, "y": 480 }, "config": {} },
      { "id": "herdr_checks1", "type": "action.noop", "label": "Herdr: checks HTTP failed", "position": { "x": 880, "y": 480 }, "config": {} },
      { "id": "herdr_checks2", "type": "action.noop", "label": "Herdr: recheck HTTP failed", "position": { "x": 3300, "y": 400 }, "config": {} },
      { "id": "herdr_pending", "type": "action.noop", "label": "Herdr: checks pending", "position": { "x": 1320, "y": 480 }, "config": {} },
      { "id": "herdr_changes_requested", "type": "action.noop", "label": "Herdr: changes requested", "position": { "x": 1540, "y": 320 }, "config": {} },
      { "id": "herdr_review_required", "type": "action.noop", "label": "Herdr: review required", "position": { "x": 1540, "y": 440 }, "config": {} },
      { "id": "herdr_pr_checkout", "type": "action.noop", "label": "Herdr: PR checkout failed", "position": { "x": 1540, "y": 620 }, "config": {} },
      { "id": "herdr_test_http", "type": "action.noop", "label": "Herdr: testRun HTTP failed", "position": { "x": 2640, "y": 520 }, "config": {} },
      { "id": "herdr_test_fail", "type": "action.noop", "label": "Herdr: testRun not ok; files kept", "position": { "x": 3080, "y": 400 }, "config": {} },
      { "id": "herdr_wait_timeout", "type": "action.noop", "label": "Herdr: agent wait timeout", "position": { "x": 1760, "y": 40 }, "config": {} },
      { "id": "herdr_wait_fail", "type": "action.noop", "label": "Herdr: agent wait failure", "position": { "x": 1980, "y": 40 }, "config": {} },
      { "id": "herdr_receipt", "type": "action.noop", "label": "Herdr: receipt not ok", "position": { "x": 2200, "y": 480 }, "config": {} },
      { "id": "herdr_commit", "type": "action.noop", "label": "Herdr: commit failed", "position": { "x": 3080, "y": 40 }, "config": {} },
      { "id": "herdr_push", "type": "action.noop", "label": "Herdr: push failed", "position": { "x": 3300, "y": 40 }, "config": {} },

      { "id": "herdr_budget", "type": "action.noop", "label": "Herdr: still red (budget)", "position": { "x": 3740, "y": 240 }, "config": {} }
    ],
    "edges": [
      { "id": "e_start_trigger", "source": "trigger", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_form", "source": "form", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_hook", "source": "hook", "sourceHandle": "out", "target": "join_start", "targetHandle": "in" },
      { "id": "e_start_git", "source": "join_start", "sourceHandle": "out", "target": "git", "targetHandle": "in" },
      { "id": "e2", "source": "git", "sourceHandle": "success", "target": "view", "targetHandle": "in" },
      { "id": "e2f", "source": "git", "sourceHandle": "failure", "target": "herdr_git", "targetHandle": "in" },
      { "id": "e3", "source": "view", "sourceHandle": "success", "target": "checks", "targetHandle": "in" },
      { "id": "e3f", "source": "view", "sourceHandle": "failure", "target": "herdr_no_pr", "targetHandle": "in" },
      { "id": "e4", "source": "checks", "sourceHandle": "success", "target": "switch_checks", "targetHandle": "in" },
      { "id": "e4f", "source": "checks", "sourceHandle": "failure", "target": "herdr_checks1", "targetHandle": "in" },
      { "id": "e5", "source": "switch_checks", "sourceHandle": "case-0", "target": "review_snap", "targetHandle": "in" },
      { "id": "e5a", "source": "review_snap", "sourceHandle": "out", "target": "switch_review", "targetHandle": "in" },
      { "id": "e5b", "source": "switch_review", "sourceHandle": "case-0", "target": "herdr_changes_requested", "targetHandle": "in" },
      { "id": "e5c", "source": "switch_review", "sourceHandle": "case-1", "target": "herdr_review_required", "targetHandle": "in" },
      { "id": "e5d", "source": "switch_review", "sourceHandle": "default", "target": "done_mergeable", "targetHandle": "in" },
      { "id": "e7", "source": "switch_checks", "sourceHandle": "case-1", "target": "pr_checkout", "targetHandle": "in" },
      { "id": "e8", "source": "switch_checks", "sourceHandle": "default", "target": "herdr_pending", "targetHandle": "in" },
      { "id": "e9", "source": "pr_checkout", "sourceHandle": "success", "target": "wait", "targetHandle": "in" },
      { "id": "e9f", "source": "pr_checkout", "sourceHandle": "failure", "target": "herdr_pr_checkout", "targetHandle": "in" },
      { "id": "e12", "source": "wait", "sourceHandle": "pending", "target": "agent", "targetHandle": "in" },
      { "id": "e13", "source": "wait", "sourceHandle": "out", "target": "receipt", "targetHandle": "in" },
      { "id": "e14", "source": "wait", "sourceHandle": "timeout", "target": "herdr_wait_timeout", "targetHandle": "in" },
      { "id": "e15", "source": "wait", "sourceHandle": "failure", "target": "herdr_wait_fail", "targetHandle": "in" },
      { "id": "e16", "source": "receipt", "sourceHandle": "out", "target": "if_receipt_ok", "targetHandle": "in" },
      { "id": "e17", "source": "if_receipt_ok", "sourceHandle": "pass", "target": "fix_test", "targetHandle": "in" },
      { "id": "e18", "source": "if_receipt_ok", "sourceHandle": "fail", "target": "herdr_receipt", "targetHandle": "in" },
      { "id": "e18a", "source": "fix_test", "sourceHandle": "success", "target": "if_fix_test", "targetHandle": "in" },
      { "id": "e18b", "source": "fix_test", "sourceHandle": "failure", "target": "herdr_test_http", "targetHandle": "in" },
      { "id": "e18c", "source": "if_fix_test", "sourceHandle": "pass", "target": "fix_commit", "targetHandle": "in" },
      { "id": "e18d", "source": "if_fix_test", "sourceHandle": "fail", "target": "herdr_test_fail", "targetHandle": "in" },
      { "id": "e18e", "source": "fix_commit", "sourceHandle": "success", "target": "fix_push", "targetHandle": "in" },
      { "id": "e18f", "source": "fix_commit", "sourceHandle": "failure", "target": "herdr_commit", "targetHandle": "in" },
      { "id": "e18g", "source": "fix_push", "sourceHandle": "success", "target": "checks2", "targetHandle": "in" },
      { "id": "e18h", "source": "fix_push", "sourceHandle": "failure", "target": "herdr_push", "targetHandle": "in" },

      { "id": "e19", "source": "checks2", "sourceHandle": "success", "target": "if_green2", "targetHandle": "in" },
      { "id": "e19f", "source": "checks2", "sourceHandle": "failure", "target": "herdr_checks2", "targetHandle": "in" },
      { "id": "e20", "source": "if_green2", "sourceHandle": "pass", "target": "done_after_fix", "targetHandle": "in" },
      { "id": "e21", "source": "if_green2", "sourceHandle": "fail", "target": "herdr_budget", "targetHandle": "in" }
    ]
  }
}
