[Unit]
Description=graphwing Cloudflare quick tunnel (ephemeral trycloudflare.com)
After=network-online.target graphwing-api.service
Wants=network-online.target
Requires=graphwing-api.service

[Service]
Type=simple
WorkingDirectory=@GRAPHWING_HOME@
Environment=HOME=@HOME@
Environment=PATH=@PATH@
ExecStart=@CLOUDFLARED@ tunnel --no-autoupdate --url http://127.0.0.1:@PORT@
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
