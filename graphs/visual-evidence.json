{
  "slug": "graphwing-visual-evidence",
  "name": "graphwing-visual-evidence",
  "description": "One bounded pre-commit visual evidence round. Strict preflight resolves a stable preview, round 1 captures before plus candidate while later rounds capture candidate only against prior published history, and the declared browser recipe captures the real served page, inspection queues at most one targeted recapture per failed role before one final all-capture inspection, an independent UI reviewer runs, durable Graphwing artifacts are handed to Rewst, Rewst's GitHub integration associates them with the issue and posts the exact server-composed comment, and an optional exact planning-pane prompt leaves the preview stack alive. Every wait has a timeout terminal, there is no cycle, and this graph never commits, pushes, or tears down the preview.",
  "canary": {
    "fixture": "deterministic-visual-round-v1",
    "issue": "https://github.com/tfournet/graphwing/issues/52",
    "route": "/canary/visual-evidence",
    "scenario": "served-page-canary",
    "expected_steps": ["preflight", "preview", "before", "candidate", "inspect", "review", "handoff", "github-upload", "publish", "github-comment", "pre-commit"]
  },
  "spec": {
    "meta": { "useSearchAttributes": true },
    "nodes": [
      { "id": "trigger", "type": "trigger.manual", "label": "Start visual round", "position": { "x": 0, "y": 80 }, "config": {} },
      { "id": "form", "type": "trigger.form", "label": "Visual round form", "position": { "x": 0, "y": 200 }, "config": { "enabled": true, "allowDrafts": false, "inputs": { "build_id": { "type": "string", "required": true }, "event_id": { "type": "string", "required": true }, "reviewer": { "type": "string", "required": false } } } },
      { "id": "hook", "type": "trigger.webhook", "label": "Visual round webhook", "position": { "x": 0, "y": 320 }, "config": { "enabled": true, "requireAuthHeader": true, "headerKey": "x-rewst-secret", "headerValue": "$GRAPHWING_HOOK_SECRET", "allowedMethods": ["POST"] } },
      { "id": "join_start", "type": "logic.join.any", "label": "Start from one trigger", "position": { "x": 160, "y": 200 }, "config": { "stopOnFirst": true } },

      { "id": "preflight", "type": "action.graphwing.POST:/v1/build/visual/preflight", "label": "Strict visual preflight", "position": { "x": 320, "y": 200 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}" } },
      { "id": "preview", "type": "action.graphwing.POST:/v1/build/visual/preview", "label": "Start or resume stable preview", "position": { "x": 480, "y": 200 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.preview", "holder": "event:{{ CTX.INPUT.event_id }}" } },

      { "id": "before_required", "type": "logic.filter", "label": "Round 1 needs a before capture; later rounds use published history", "position": { "x": 560, "y": 120 }, "config": { "group": "AND", "rules": [{ "path": "data.round", "op": "equals", "value": 1 }] } },
      { "id": "join_candidate_capture", "type": "logic.join.any", "label": "Before captured or prior published history selected", "position": { "x": 880, "y": 120 }, "config": { "stopOnFirst": true } },
      { "id": "wait_before", "type": "action.wait.webhook", "label": "Wait for real-page before capture", "position": { "x": 640, "y": 120 }, "config": { "alias": "wait_before", "allowedMethods": ["POST"], "authMode": "token", "responseStatus": 200, "timeoutSeconds": 600 } },
      { "id": "capture_before", "type": "action.graphwing.POST:/v1/build/visual/scenario", "label": "Browser scenario: before", "position": { "x": 640, "y": 280 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.before", "holder": "event:{{ CTX.INPUT.event_id }}", "role": "before", "response_webhook_url": "{{ TASKS.wait_before.pending.resumeUrl }}", "response_webhook_token": "{{ TASKS.wait_before.pending.resumeToken }}" } },
      { "id": "before_ok", "type": "logic.filter", "label": "Before capture is real evidence", "position": { "x": 800, "y": 120 }, "config": { "group": "AND", "rules": [{ "path": "request.body.status", "op": "equals", "value": "ok" }, { "path": "request.body.ok", "op": "equals", "value": true }] } },

      { "id": "wait_candidate", "type": "action.wait.webhook", "label": "Wait for real-page candidate capture", "position": { "x": 960, "y": 120 }, "config": { "alias": "wait_candidate", "allowedMethods": ["POST"], "authMode": "token", "responseStatus": 200, "timeoutSeconds": 600 } },
      { "id": "capture_candidate", "type": "action.graphwing.POST:/v1/build/visual/scenario", "label": "Browser scenario: candidate", "position": { "x": 960, "y": 280 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.candidate", "holder": "event:{{ CTX.INPUT.event_id }}", "role": "candidate", "response_webhook_url": "{{ TASKS.wait_candidate.pending.resumeUrl }}", "response_webhook_token": "{{ TASKS.wait_candidate.pending.resumeToken }}" } },
      { "id": "candidate_ok", "type": "logic.filter", "label": "Candidate capture is real evidence", "position": { "x": 1120, "y": 120 }, "config": { "group": "AND", "rules": [{ "path": "request.body.status", "op": "equals", "value": "ok" }, { "path": "request.body.ok", "op": "equals", "value": true }] } },

      { "id": "inspect", "type": "action.graphwing.POST:/v1/build/visual/inspect", "label": "Inspect legibility, context, route, and obstruction", "position": { "x": 1280, "y": 120 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.inspect", "holder": "event:{{ CTX.INPUT.event_id }}" } },
      { "id": "inspect_ok", "type": "logic.filter", "label": "Images publishable?", "position": { "x": 1440, "y": 120 }, "config": { "group": "AND", "rules": [{ "path": "data.ok", "op": "equals", "value": true }] } },
      { "id": "join_recapture", "type": "logic.join.any", "label": "Join bounded role recapture lane", "position": { "x": 1440, "y": 300 }, "config": { "stopOnFirst": true } },
      { "id": "recapture_before_needed", "type": "logic.filter", "label": "Before role queued?", "position": { "x": 1520, "y": 300 }, "config": { "group": "AND", "rules": [{ "path": "TASKS.inspect.data.recapture_roles.before", "op": "equals", "value": true }] } },
      { "id": "recapture_before", "type": "action.graphwing.POST:/v1/build/visual/scenario", "label": "Recapture failed before viewports once", "position": { "x": 1600, "y": 260 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 600, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.recapture-before", "holder": "event:{{ CTX.INPUT.event_id }}", "role": "before", "only": "{{ TASKS.inspect.data.recapture_by_role.before }}" } },
      { "id": "join_after_before", "type": "logic.join.any", "label": "Before recapture or bypass", "position": { "x": 1680, "y": 300 }, "config": { "stopOnFirst": true } },
      { "id": "recapture_candidate_needed", "type": "logic.filter", "label": "Candidate role queued?", "position": { "x": 1760, "y": 300 }, "config": { "group": "AND", "rules": [{ "path": "TASKS.inspect.data.recapture_roles.candidate", "op": "equals", "value": true }] } },
      { "id": "recapture_candidate", "type": "action.graphwing.POST:/v1/build/visual/scenario", "label": "Recapture failed candidate viewports once", "position": { "x": 1840, "y": 260 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 600, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.recapture-candidate", "holder": "event:{{ CTX.INPUT.event_id }}", "role": "candidate", "only": "{{ TASKS.inspect.data.recapture_by_role.candidate }}" } },
      { "id": "join_after_candidate", "type": "logic.join.any", "label": "Candidate recapture or bypass", "position": { "x": 1920, "y": 300 }, "config": { "stopOnFirst": true } },
      { "id": "inspect_recapture", "type": "action.graphwing.POST:/v1/build/visual/inspect", "label": "Final inspection over all captures", "position": { "x": 2000, "y": 300 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.inspect-recapture", "holder": "event:{{ CTX.INPUT.event_id }}" } },
      { "id": "inspect_recapture_ok", "type": "logic.filter", "label": "All recaptured images publishable?", "position": { "x": 2080, "y": 300 }, "config": { "group": "AND", "rules": [{ "path": "data.ok", "op": "equals", "value": true }] } },
      { "id": "join_inspected", "type": "logic.join.any", "label": "Join clean inspection", "position": { "x": 1760, "y": 120 }, "config": { "stopOnFirst": true } },

      { "id": "wait_review", "type": "action.wait.webhook", "label": "Wait for automated UI review", "position": { "x": 1920, "y": 60 }, "config": { "alias": "wait_review", "allowedMethods": ["POST"], "authMode": "token", "responseStatus": 200, "timeoutSeconds": 900 } },
      { "id": "review", "type": "action.graphwing.POST:/v1/build/visual/review", "label": "Independent UI and accessibility review", "position": { "x": 1920, "y": 220 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.review", "holder": "event:{{ CTX.INPUT.event_id }}", "reviewer": "{{ CTX.INPUT.reviewer }}", "response_webhook_url": "{{ TASKS.wait_review.pending.resumeUrl }}", "response_webhook_token": "{{ TASKS.wait_review.pending.resumeToken }}" } },
      { "id": "review_ok", "type": "logic.filter", "label": "Reviewer explicitly passed", "position": { "x": 2080, "y": 60 }, "config": { "group": "AND", "rules": [{ "path": "request.body.status", "op": "equals", "value": "ok" }, { "path": "request.body.ok", "op": "equals", "value": true }, { "path": "request.body.verdict", "op": "equals", "value": "PASS" }] } },

      { "id": "handoff", "type": "action.graphwing.POST:/v1/build/visual/handoff", "label": "Durable artifact handoff", "position": { "x": 2240, "y": 60 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 60, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.handoff", "holder": "event:{{ CTX.INPUT.event_id }}", "ttl_seconds": 900 } },
      { "id": "github_upload", "type": "action.github.issue.uploadArtifacts", "label": "Rewst GitHub: associate artifact files with issue", "position": { "x": 2400, "y": 60 }, "config": { "issue": "{{ TASKS.handoff.data.issue }}", "grants": "{{ TASKS.handoff.data.grants }}", "durableArtifactIds": "{{ TASKS.handoff.data.handoff.artifacts }}" } },
      { "id": "publish", "type": "action.graphwing.POST:/v1/build/visual/publish", "label": "Record uploads and compose GitHub comment", "position": { "x": 2560, "y": 60 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.publish", "holder": "event:{{ CTX.INPUT.event_id }}", "uploads": "{{ TASKS.github_upload.data.uploads }}" } },
      { "id": "github_comment", "type": "action.github.issue.comment", "label": "Rewst GitHub: post visual evidence comment", "position": { "x": 2720, "y": 60 }, "config": { "owner": "{{ TASKS.publish.data.issue.owner }}", "repo": "{{ TASKS.publish.data.issue.repo }}", "issue_number": "{{ TASKS.publish.data.issue.number }}", "body": "{{ TASKS.publish.data.comment }}" } },
      { "id": "publish_result", "type": "action.graphwing.POST:/v1/build/visual/publish-result", "label": "Record authoritative GitHub comment receipt", "position": { "x": 2800, "y": 60 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.publish-result", "holder": "event:{{ CTX.INPUT.event_id }}", "comment_url": "{{ TASKS.github_comment.data.url }}", "artifact_ids": "{{ TASKS.publish.data.uploads.*.artifact_id }}" } },
      { "id": "human_enabled", "type": "logic.filter", "label": "Human visual review requested?", "position": { "x": 2880, "y": 60 }, "config": { "group": "AND", "rules": [{ "path": "data.human_review", "op": "equals", "value": true }] } },
      { "id": "planning_prompt", "type": "action.graphwing.POST:/v1/build/visual/prompt", "label": "Prompt exact saved planning pane", "position": { "x": 3040, "y": 180 }, "config": { "integrationInstanceId": "$GRAPHWING_INSTANCE", "timeout": 30, "build_id": "{{ CTX.INPUT.build_id }}", "event_id": "{{ CTX.INPUT.event_id }}.prompt", "holder": "event:{{ CTX.INPUT.event_id }}" } },
      { "id": "join_done", "type": "logic.join.any", "label": "Join completed visual round", "position": { "x": 3200, "y": 60 }, "config": { "stopOnFirst": true } },
      { "id": "precommit_done", "type": "action.noop", "label": "Pre-commit evidence complete; preview stack remains alive", "position": { "x": 3360, "y": 60 }, "config": { "receipt": "durable artifact IDs, GitHub comment URL, round, preview URL" } },

      { "id": "join_fail", "type": "logic.join.any", "label": "Join fail-closed terminals", "position": { "x": 2880, "y": 420 }, "config": { "stopOnFirst": true } },
      { "id": "failed", "type": "action.noop", "label": "Visual evidence incomplete; no commit and preview preserved", "position": { "x": 3040, "y": 420 }, "config": {} }
    ],
