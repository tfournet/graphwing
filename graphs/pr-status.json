      {
        "id": "status_reason_closed",
        "type": "transforms.objectBuilder",
        "label": "Final policy: closed",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "alias": "status_reason_closed",
          "version": 1,
          "mappings": [
            {
